@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import toothCount, toothPhase, toothPitchDeg, rootDiameter, rootRadius, tipCircleRadius, tipFilletDiameter, tipFilletRadius, tipOuterRadius, discThickness, envelopeMinY, envelopeSizeY, envelopeSizeX, envelopeSizeZ, gearModule, hexBossVertex from "params.kcl"

assert(toothCount, isGreaterThan = 2, error = "need at least three teeth")
assert(abs(toothCount - floor(toothCount)), isLessThan = 0.0000001, error = "toothCount must be an integer")
assert(rootDiameter, isGreaterThan = 0mm, error = "root diameter must be positive")
assert(rootRadius, isGreaterThan = hexBossVertex, error = "tooth spaces must stay outside the hex boss")
assert(tipFilletDiameter, isGreaterThan = 0mm, error = "tip fillet diameter must be positive")
assert(tipFilletRadius, isGreaterThan = 0mm, error = "tip fillet radius must be positive")
assert(tipCircleRadius, isGreaterThan = rootRadius, error = "tip-circle axes must sit outside the root")
assert(tipOuterRadius, isGreaterThan = tipCircleRadius, error = "addendum must sit outside the tip-circle axes")
assert(discThickness, isGreaterThan = 0mm, error = "disc thickness must be positive")
assert(envelopeSizeY, isGreaterThan = discThickness, error = "hex boss must stand above the disc")
assert(toothPitchDeg, isGreaterThan = 0deg, error = "tooth pitch must be positive")
assert(gearModule, isGreaterThan = 0mm, error = "gear module must be positive")
assert(envelopeSizeX, isGreaterThan = 0mm, error = "envelope width must be positive")
assert(envelopeSizeZ, isGreaterThan = 0mm, error = "envelope depth must be positive")
assert(tipOuterRadius, isLessThan = envelopeSizeX, error = "disc must fit in the X envelope")
assert(tipOuterRadius, isLessThan = envelopeSizeZ, error = "disc must fit in the Z envelope")
assert(abs(toothCount - 36), isLessThan = 0.5, error = "the toothed outline below is written out for 36 teeth")

// Flanks meet the root at about +-0.3 pitch (~3 deg at 10 deg), leaving a ~4 deg space.
rootHalfAngle = toothPitchDeg * 0.3

fn xz(@radius, ang) {
  return [radius * cos(ang), radius * sin(ang)]
}

fn outerTangent(@rootPt, centre, fillet) {
  vx = (centre[0] - rootPt[0]): number(_)
  vz = (centre[1] - rootPt[1]): number(_)
  rr = fillet: number(_)
  d2 = vx * vx + vz * vz
  assert(d2, isGreaterThan = rr * rr, error = "root point lies inside the tip circle")
  a = rr * rr / d2
  s = rr / d2 * sqrt(d2 - (rr * rr))
  firstX = centre[0]: number(_) - (a * vx) + s * (0 - vz)
  firstZ = centre[1]: number(_) - (a * vz) + s * vx
  secondX = centre[0]: number(_) - (a * vx) - (s * (0 - vz))
  secondZ = centre[1]: number(_) - (a * vz) - (s * vx)
  return if firstX * firstX + firstZ * firstZ > secondX * secondX + secondZ * secondZ {
    [firstX: mm, firstZ: mm]
  } else {
    [secondX: mm, secondZ: mm]
  }
}

// Tooth k about a = toothPhase + k*toothPitchDeg: [rootMinus, tipMinus, tipPlus, rootPlus, tipCentre].
fn toothPts(@k) {
  a = toothPhase + k * toothPitchDeg
  c = xz(tipCircleRadius, ang = a)
  rm = xz(rootRadius, ang = a - rootHalfAngle)
  rp = xz(rootRadius, ang = a + rootHalfAngle)
  return [
    rm,
    outerTangent(rm, centre = c, fillet = tipFilletRadius),
    outerTangent(rp, centre = c, fillet = tipFilletRadius),
    rp,
    c
  ]
}

// Seating at datum A: sketch X = world +X, sketch Y = world +Z, extrude +Y.
seatingPlane = {
  origin = { x = 0mm, y = envelopeMinY, z = 0mm },
  xAxis = { x = 1, y = 0, z = 0 },
  yAxis = { x = 0, y = 0, z = 1 }
}

t0 = toothPts(0)
t1 = toothPts(1)
t2 = toothPts(2)
t3 = toothPts(3)
t4 = toothPts(4)
t5 = toothPts(5)
t6 = toothPts(6)
t7 = toothPts(7)
