@settings(defaultLengthUnit = mm, kclVersion = 2.0)

span = 165.0mm
axialChord = 47.6144470215mm
trailingEdgeY = -21.59972305301mm
trailingEdgeRadius = 0.435mm
profilePerimeter = 123.78447524923155mm
trueChord = 52.284640202739865mm
signedStagger = -24.40085023652175deg

// SPLEEN C1 turbine cascade blade. Geometry only; material and density unspecified.
// Source: SPLEENC1_Geometry_Airfoil_2D_v1.xlsx, sheet SPLEENC1_Coord.
// Source SHA256: eb02e45c1ff8b6f94fcb7a91209f5b0113c96b1ffa27f9cbaff18133cb37a4f2
// Coordinates transcribed without reduction: workbook metres multiplied by 1000.
// PS = A/B rows 3:1003; SS = C/D rows 3:1003, both originally LE -> TE.
// The published LE at (0,0) fixes the datum; negative-x nose points remain.
// The source already includes stagger. No rotation, centering, twist, or taper.
// Piecewise-linear interpolation is the approved construction convention.
// Documentary reference parameters below do not constrain editable parameters.


sx = axialChord / 47.6144470215mm
sy = trailingEdgeY / -21.59972305301mm
assert(span, isGreaterThan = 0mm)
assert(axialChord, isGreaterThan = 0mm)
assert(trailingEdgeY, isLessThan = 0mm)
assert(trailingEdgeRadius, isGreaterThan = 0mm)
assert(profilePerimeter, isGreaterThan = 0mm)
assert(trueChord, isGreaterThan = 0mm)
assert(signedStagger, isGreaterThan = -90deg, isLessThan = 0deg)
assert(sx, isGreaterThan = 0_)
assert(sy, isGreaterThan = 0_)

// Source topology and polygon metrics independently audited by check_kcl_source.py.
// Every source coordinate is embedded directly in the sketch below.
sourcePointsPerSide = 1001
sourceLoopVertices = 2000
sourceMinimumSegmentLength = 0.05762974185123898mm
sourceSignedAreaMm2 = 230.63711778196603_
minimumSegmentLengthBound = sourceMinimumSegmentLength * min([sx, sy])
signedPolygonAreaMm2 = sourceSignedAreaMm2 * sx * sy
assert(sourcePointsPerSide, isEqualTo = 1001)
assert(sourceLoopVertices, isEqualTo = 2000)
assert(minimumSegmentLengthBound, isGreaterThan = 0mm)
assert(signedPolygonAreaMm2, isGreaterThan = 0_)

// Datum references preserve the spreadsheet's right-handed XY frame.
spanStartPlane = XY
axialDatum = XZ
pitchwiseDatum = YZ
spanEndPlane = offsetPlane(XY, offset = span)
chordConstruction = sketch(on = XY) {
  chordDatum = line(start = [0mm, 0mm], end = [axialChord, trailingEdgeY], construction = true)
}

