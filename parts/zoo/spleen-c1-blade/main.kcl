// The last SS edge returns to the exact original LE; no extra closing edge.
closedAirfoil = region(segments = [airfoil.ps0000[0], airfoil.ps0001[0]])
blade = extrude(
  closedAirfoil,
  length = span,
  method = NEW,
  tagStart = $spanStart,
  tagEnd = $spanEnd,
)

