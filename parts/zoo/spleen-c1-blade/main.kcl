spanCaps = {
  spanStart = blade.faces.spanStart,
  spanEnd = blade.faces.spanEnd
}
assert(count(pressureSide), isEqualTo = 1000)
assert(count(suctionSide), isEqualTo = 1000)

// Analytic physical checks valid for independent span/x/y edits.
// The external verification recomputes perimeter from every scaled source edge.
analytic = {
  areaMm2 = signedPolygonAreaMm2,
  volumeMm3 = signedPolygonAreaMm2 * (span / 1mm),
  centerOfMassMm = [
    20.61965798483844_ * sx,
    1.044925389020302_ * sy,
    span / 1mm / 2
  ],
  landmarkChordMm = sqrt((axialChord / 1mm) ^ 2 + (trailingEdgeY / 1mm) ^ 2),
  landmarkStagger = atan2(y = trailingEdgeY, x = axialChord)
}
// Reference comparisons are nominal diagnostics, deliberately not assertions.
nominalChecks = {
  chordDifferenceMm = analytic.landmarkChordMm - (trueChord / 1mm),
  staggerDifference = analytic.landmarkStagger - signedStagger,
  nominalPerimeterMm = profilePerimeter / 1mm,
  nominalSurfaceAreaMm2 = 2 * 230.63711778179277_ + profilePerimeter / 1mm * (165mm / 1mm),
  nominalTrailingEdgeRadiusMm = trailingEdgeRadius / 1mm
}
hide(airfoil)
blade
