// Positive dimensions and ordered extents guard intent without equality locks.
// Unused detail parameters are guarded for their future feature families.
assert(
  plateWidth,
  isGreaterThan = 0mm,
  isLessThan = 2 * overallHeight,
  error = "plateWidth: outside geometric bounds",
)
