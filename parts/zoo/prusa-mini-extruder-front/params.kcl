)
assert(
  rightCounterboreFullDepth,
  isGreaterThan = 0mm,
  isLessThan = rightCounterboreEnd,
  error = "rightCounterboreFullDepth: outside geometric bounds",
)
assert(
  nutAcrossFlats,
  isGreaterThan = screwDiameter,
  isLessThan = lugBossDiameter,
  error = "nutAcrossFlats: outside geometric bounds",
)
assert(
  nutCornerRadius,
  isGreaterThan = screwDiameter / 2,
  isLessThan = lugBossDiameter / 2,
  error = "nutCornerRadius: outside geometric bounds",
)
assert(
  bridgeLayerHeight,
  isGreaterThan = 0mm,
  isLessThan = nutFullDepth,
  error = "bridgeLayerHeight: outside geometric bounds",
)
assert(
  lowerTransitionLength,
  isGreaterThan = 0mm,
  isLessThan = plateThickness - keyBackDepth,
  error = "lowerTransitionLength: outside geometric bounds",
)
assert(
  longPilotLength,
  isGreaterThan = 0mm,
  isLessThan = plateThickness - longCounterboreEnd,
  error = "longPilotLength: outside geometric bounds",
)
assert(
  pivotMouthDiameter,
  isGreaterThan = screwDiameter,
  isLessThan = counterboreDiameter,
  error = "pivotMouthDiameter: outside geometric bounds",
)
