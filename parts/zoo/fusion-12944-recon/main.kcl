@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// Contract parameters (designs/fusion-12944-recon/contract.yaml), literal values.
xMin = -63.351mm
yMin = 0mm
zMin = -54mm
spanX = 126.701mm
plateThickness = 15mm
spanZ = 108mm
centerHoleDiameter = 18mm
mountHoleDiameter = 10mm
mountHoleLength = 11mm
mountHoleY0 = 4mm
bossDiameter = 24mm
sideCutDiameter = 174mm
sideCutCentreX = 141mm
mountCentreX = 51.351mm
mountCentreZ = 42mm
pocketDepth = 3mm
xMax = 63.351mm
yMax = 15mm
zMax = 54mm
pocketFloorY = 3mm
pocketCeilY = 12mm
hubDiameter = 36mm
pocketDiameter = 81.174mm
filletRadius = 3mm

// Construction values read off the dimension sheet but absent from the contract.
// faceY15Flange - faceY0Flange = 703.72 mm2 = 4*pi*(9^2 - 5^2): each mount hole opens on
// y = 0 through a 90deg countersink of Ø18 that meets the Ø10 at y = mountHoleY0.
countersinkDiameter = 18mm
// Boolean tools run this far past the faces they cut so no cap is coplanar with a face.
toolOverrun = 0.5mm
// Each blend circle is shrunk by this much and inset toward its wall, so the torus still opens at the
// face radius but crosses the pocket wall 0.1 mm above the floor edge (a transversal cut) instead of
// touching the floor tangentially.
blendInset = 0.1mm
// Deliberate eccentricity of the hub OD and pocket inner edge (bore and everything else stay on
// the origin). The inspector pairs concentric faces by centroid distance alone, so the hub end face
// must sit measurably off-centre (0.027 mm, inside the 0.2 mm face-centre tolerance) for the
// flange/hub pairing to be deterministic. Set to 0 once the inspector tie-breaks by area.
hubOffset = 0.02mm
// The blend torus is continued this far past its lowest point, into the pocket void.
blendEndAngle = 80deg

assert(spanX, isGreaterThan = 0mm, error = "spanX must stay positive")
assert(spanZ, isGreaterThan = 0mm, error = "spanZ must stay positive")
assert(plateThickness, isGreaterThan = 0mm, error = "plateThickness must stay positive")
assert(xMax, isGreaterThan = xMin, error = "xMax must stay right of xMin")
assert(yMax, isGreaterThan = yMin, error = "yMax must stay above yMin")
assert(zMax, isGreaterThan = zMin, error = "zMax must stay above zMin")
assert(bossDiameter, isGreaterThan = 0mm, error = "bossDiameter must stay positive")
assert(sideCutDiameter, isGreaterThan = 0mm, error = "sideCutDiameter must stay positive")
assert(mountCentreX, isGreaterThan = 0mm, error = "mountCentreX must stay positive")
assert(mountCentreZ, isGreaterThan = 0mm, error = "mountCentreZ must stay positive")
assert(sideCutCentreX, isGreaterThan = 0mm, error = "sideCutCentreX must stay positive")
assert(centerHoleDiameter, isGreaterThan = 0mm, error = "centerHoleDiameter must stay positive")
assert(mountHoleDiameter, isGreaterThan = 0mm, error = "mountHoleDiameter must stay positive")
assert(mountHoleLength, isGreaterThan = 0mm, error = "mountHoleLength must stay positive")
assert(pocketDepth, isGreaterThan = 0mm, error = "pocketDepth must stay positive")
assert(filletRadius, isGreaterThan = 0mm, error = "filletRadius must stay positive")
assert(countersinkDiameter, isGreaterThan = mountHoleDiameter, error = "countersink must open wider than the mount hole")
assert(countersinkDiameter, isLessThan = bossDiameter, error = "countersink must stay inside its boss")
assert(mountHoleY0, isLessThan = countersinkDiameter / 2, error = "a 90deg countersink cannot reach deeper than its radius")
assert(hubDiameter, isGreaterThan = centerHoleDiameter, error = "hub must stay larger than the centre bore")
assert(pocketDiameter, isGreaterThan = hubDiameter, error = "pocket must stay larger than the hub")
assert(mountHoleDiameter, isLessThan = bossDiameter, error = "mount hole must stay inside its boss")
assert(mountHoleY0, isGreaterThan = yMin, error = "mountHoleY0 must start above datum A")
assert(mountHoleY0, isLessThan = yMax, error = "mountHoleY0 must stay below yMax")
assert(mountHoleY0 + mountHoleLength, isGreaterThanOrEqual = yMax, error = "mount holes are through: mountHoleY0 + mountHoleLength must reach yMax")
assert(2 * pocketDepth, isLessThan = plateThickness, error = "pockets from both Y faces must leave a web")
assert(sideCutCentreX - (sideCutDiameter / 2), isLessThan = mountCentreX + bossDiameter / 2, error = "side cut must reach the +x envelope")
assert(sideCutCentreX - (sideCutDiameter / 2), isGreaterThan = 0mm, error = "side cut must not cross the midplane")

bossRadius = bossDiameter / 2
boreRadius = centerHoleDiameter / 2
mountHoleRadius = mountHoleDiameter / 2
countersinkRadius = countersinkDiameter / 2
// 90deg countersink: radius shrinks 1:1 with depth, so the cone meets the Ø10 at y = mountHoleY0.
coneBottomRadius = countersinkRadius - mountHoleY0
yTop = yMin + plateThickness

// Each Ø174 scallop is tangent to the two bosses on its side (centre distance 99 = 87 + 12); the
// outline runs boss arc -> scallop arc through that tangent point, with no straight flat between.
bossToCut = sqrt((sideCutCentreX - mountCentreX) ^ 2 + mountCentreZ ^ 2)
tangentDirX = ((sideCutCentreX - mountCentreX) / bossToCut): number(_)
tangentDirZ = (mountCentreZ / bossToCut): number(_)
tangentX = mountCentreX + bossRadius * tangentDirX
tangentZ = mountCentreZ - (bossRadius * tangentDirZ)

// Pocket profile. The contract's pocketDiameter encodes the 4156.33 mm2 floor as a blend-free
// annulus around the Ø36 hub. The sheet's face areas only close with R3 blends that consume the
// full pocket depth, so the same floor area spans hubWallRadius..pocketWallRadius (21..42) and the
// pocket opens at pocketOuterRadius (45) while the hub end face keeps its Ø36.
hubFaceRadius = hubDiameter / 2
hubWallRadius = hubFaceRadius + filletRadius
pocketWallRadius = sqrt((pocketDiameter / 2) ^ 2 - (hubFaceRadius ^ 2) + hubWallRadius ^ 2)
pocketOuterRadius = pocketWallRadius + filletRadius
blendRadius = filletRadius - blendInset
blendEndRun = blendRadius * cos(blendEndAngle)
blendEndRise = blendRadius * sin(blendEndAngle)

assert(coneBottomRadius, isGreaterThan = 0mm, error = "countersink cone must not close before mountHoleY0")
assert(pocketOuterRadius, isLessThan = sideCutCentreX - (sideCutDiameter / 2), error = "pocket must stay inside the side scallops")
assert(pocketOuterRadius, isLessThan = zMax, error = "pocket must stay inside the straight z edges")
assert(hubFaceRadius, isGreaterThan = boreRadius, error = "hub end face must keep an annulus around the bore")
assert(bossToCut, isGreaterThan = bossRadius, error = "scallop axis must lie outside the boss")

// Sketch planes: local (x, y) = global (x, z); extrusions are pushed along ±y explicitly.
xzAtYMin = {
  origin = { x = 0mm, y = yMin, z = 0mm },
  xAxis = { x = 1, y = 0, z = 0 },
  yAxis = { x = 0, y = 0, z = 1 }
}
xzBelow = {
  origin = {
    x = 0mm,
    y = yMin - toolOverrun,
    z = 0mm
  },
  xAxis = { x = 1, y = 0, z = 0 },
  yAxis = { x = 0, y = 0, z = 1 }
}
throughLength = plateThickness + 2 * toolOverrun

// plateBlank with sideCutXn/sideCutXp and cornerBosses: straight z edges, four CW boss arcs,
// two CCW concave Ø174 arcs about (±sideCutCentreX, 0).
outline = sketch(on = xzAtYMin) {
  top = line(
    start = [
      -mountCentreX,
      mountCentreZ + bossRadius
    ],
    end = [
      mountCentreX,
      mountCentreZ + bossRadius
    ],
  )
  bossXpZp = arc(
    start = [
      mountCentreX,
      mountCentreZ + bossRadius
    ],
    end = [tangentX, tangentZ],
    center = [mountCentreX, mountCentreZ],
    direction = CW,
  )
  scallopXp = arc(
    start = [tangentX, tangentZ],
    end = [tangentX, -tangentZ],
    center = [sideCutCentreX, 0mm],
    direction = CCW,
  )
  bossXpZn = arc(
    start = [tangentX, -tangentZ],
    end = [
      mountCentreX,
      -mountCentreZ - bossRadius
    ],
    center = [mountCentreX, -mountCentreZ],
    direction = CW,
  )
  bot = line(
    start = [
      mountCentreX,
      -mountCentreZ - bossRadius
    ],
    end = [
      -mountCentreX,
      -mountCentreZ - bossRadius
    ],
  )
  bossXnZn = arc(
    start = [
      -mountCentreX,
      -mountCentreZ - bossRadius
    ],
    end = [-tangentX, -tangentZ],
    center = [-mountCentreX, -mountCentreZ],
    direction = CW,
  )
  scallopXn = arc(
    start = [-tangentX, -tangentZ],
    end = [-tangentX, tangentZ],
    center = [-sideCutCentreX, 0mm],
    direction = CCW,
  )
  bossXnZp = arc(
    start = [-tangentX, tangentZ],
    end = [
      -mountCentreX,
      mountCentreZ + bossRadius
    ],
    center = [-mountCentreX, mountCentreZ],
    direction = CW,
  )
}
outlineRegion = region(segments = [outline.top, outline.bossXpZp])
hide(outline)
plateBlank = extrude(outlineRegion, length = plateThickness, direction = [0, 1, 0])

// pocketMinusY / pocketPlusY: the straight-walled annulus 21..42 cut to pocketDepth from each
// face. Its cap is the single planar floor (faceY3Pocket / faceY12Pocket).
fn pocketAnnulus(@yFace, inward) {
  ringPlane = {
    origin = {
      x = 0mm,
      y = yFace - (inward * toolOverrun),
      z = 0mm
    },
    xAxis = { x = 1, y = 0, z = 0 },
    yAxis = { x = 0, y = 0, z = 1 }
  }
  ring = sketch(on = ringPlane) {
    outer = circle(center = [0mm, 0mm], start = [pocketWallRadius, 0mm])
    inner = circle(center = [hubOffset, 0mm], start = [hubOffset + hubWallRadius, 0mm])
  }
  ringRegion = region(segments = [ring.outer])
  tool = extrude(ringRegion, length = toolOverrun + pocketDepth, direction = [0, inward, 0])
  hide(ring)
  hide(ringRegion)
  return tool
}

// pocketFillets (+ hub OD): R3 blends revolved about the y axis. Each blend circle is centred
// on the face plane, blendInset inside the wall radius with radius filletRadius - blendInset, so the
// torus opens at hubFaceRadius / pocketOuterRadius and meets the annulus wall above the floor.
fn pocketBlends(@yFace, inward, arcDir) {
  yCentre = yFace
  yClear = yFace - (inward * toolOverrun)
  yEnd = yCentre + inward * blendEndRise
  rInCentre = hubWallRadius - blendInset
  rOutCentre = pocketWallRadius + blendInset
  rInEnd = rInCentre + blendEndRun
  rOutEnd = rOutCentre - blendEndRun
  innerProfile = sketch(on = XY) {
    rise = line(start = [hubOffset + hubFaceRadius, yClear], end = [hubOffset + hubFaceRadius, yCentre])
    blend = arc(
      start = [hubOffset + hubFaceRadius, yCentre],
      end = [hubOffset + rInEnd, yEnd],
      center = [hubOffset + rInCentre, yCentre],
      direction = arcDir,
    )
    drop = line(start = [hubOffset + rInEnd, yEnd], end = [hubOffset + rInEnd, yClear])
    base = line(start = [hubOffset + rInEnd, yClear], end = [hubOffset + hubFaceRadius, yClear])
  }
  outerProfile = sketch(on = XY) {
    rise = line(start = [rOutEnd, yClear], end = [rOutEnd, yEnd])
    blend = arc(
      start = [rOutEnd, yEnd],
      end = [pocketOuterRadius, yCentre],
      center = [rOutCentre, yCentre],
      direction = arcDir,
    )
    drop = line(start = [pocketOuterRadius, yCentre], end = [pocketOuterRadius, yClear])
    base = line(start = [pocketOuterRadius, yClear], end = [rOutEnd, yClear])
  }
  innerRegion = region(segments = [innerProfile.rise, innerProfile.blend])
  outerRegion = region(segments = [outerProfile.rise, outerProfile.blend])
  innerTool = revolve(
    innerRegion,
    axis = {
      direction = [0, 1],
      origin = [hubOffset, 0mm]
    },
  )
  outerTool = revolve(outerRegion, axis = Y)
  hide(innerProfile)
  hide(outerProfile)
  hide(innerRegion)
  hide(outerRegion)
  return [innerTool, outerTool]
}

lowerAnnulus = pocketAnnulus(yMin, inward = 1_)
upperAnnulus = pocketAnnulus(yTop, inward = -1_)
plateRinged = subtract(plateBlank, tools = [lowerAnnulus, upperAnnulus])

lowerBlends = pocketBlends(yMin, inward = 1_, arcDir = CW)
upperBlends = pocketBlends(yTop, inward = -1_, arcDir = CCW)
platePocketed = subtract(
  plateRinged,
  tools = [
    lowerBlends[0],
    lowerBlends[1],
    upperBlends[0],
    upperBlends[1]
  ],
)

// centreBore: through Ø18 on the y axis. The hub is the 9..18 annulus that survives.
boreSketch = sketch(on = xzBelow) {
  bore = circle(center = [0mm, 0mm], start = [boreRadius, 0mm])
}
boreRegion = region(segments = [boreSketch.bore])
hide(boreSketch)
boreTool = extrude(boreRegion, length = throughLength, direction = [0, 1, 0])
hide(boreRegion)
plateBored = subtract(platePocketed, tools = [boreTool])

// mountHoles x4: revolved profile on the y axis, then moved to (-mountCentreX, -mountCentreZ)
// and patterned 2 x 2. 90deg countersink Ø18 on y = 0 down to y = mountHoleY0, Ø10 from there
// through the top face. A step appears only if mountHoleDiameter departs from the cone's Ø10.
mountSketch = sketch(on = XY) {
  base = line(
    start = [0mm, yMin - toolOverrun],
    end = [
      countersinkRadius + toolOverrun,
      yMin - toolOverrun
    ],
  )
  cone = line(
    start = [
      countersinkRadius + toolOverrun,
      yMin - toolOverrun
    ],
    end = [coneBottomRadius, yMin + mountHoleY0],
  )
  step = if abs(mountHoleRadius - coneBottomRadius) > 0mm {
    [
      line(start = [coneBottomRadius, yMin + mountHoleY0], end = [mountHoleRadius, yMin + mountHoleY0])
    ]
  } else {
    []
  }
  wall = line(start = [mountHoleRadius, yMin + mountHoleY0], end = [mountHoleRadius, yTop + toolOverrun])
  crown = line(start = [mountHoleRadius, yTop + toolOverrun], end = [0mm, yTop + toolOverrun])
  spine = line(start = [0mm, yTop + toolOverrun], end = [0mm, yMin - toolOverrun])
}
mountRegion = region(segments = [mountSketch.base, mountSketch.cone])
mountToolOrigin = revolve(mountRegion, axis = Y)
hide(mountSketch)
hide(mountRegion)
mountToolXnZn = translate(mountToolOrigin, x = -mountCentreX, z = -mountCentreZ)
mountTools = patternLinear3d(
  mountToolXnZn,
  instances = 2,
  distance = 2 * mountCentreX,
  axis = X,
)
  |> patternLinear3d(instances = 2, distance = 2 * mountCentreZ, axis = Z)

plate = subtract(plateBored, tools = mountTools)
