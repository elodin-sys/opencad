  coincident([tab01Left.end, noseTop.start])
  horizontalDistance([ORIGIN, tab01Left.end]) == tabStarts[0]
  verticalDistance([ORIGIN, tab01Left.end]) == bodyHeight
  coincident([noseTop.end, tipBeforeTaper.start])
  horizontalDistance([ORIGIN, noseTop.end]) == 0mm
  verticalDistance([ORIGIN, noseTop.end]) == bodyHeight
  coincident([
    tipBeforeTaper.end,
    buildPlateEndBlock.start
  ])
  horizontalDistance([ORIGIN, tipBeforeTaper.end]) == 0mm
  verticalDistance([ORIGIN, tipBeforeTaper.end]) == 0mm
}

elevationRegion = region(segments = [
  elevation.buildPlateEndBlock,
  elevation.gap01Left
])
externalPrism = extrude(
  elevationRegion,
  length = overallWidth,
  direction = [0, 1, 0],
  tagStart = $sideDatumY0,
  tagEnd = $oppositeSideY5,
)
hide(elevation)

// Cutters extend beyond the stock. Only their working flank planes intersect it.
// Both working edges pass through [0, overallWidth/2] at +/-noseAngle.
noseToolMargin = overallWidth
noseToolX0 = -noseToolMargin
noseToolX1 = actualNoseLength + noseToolMargin
noseToolYLow = overallWidth / 2 - (noseToolX1 * tan(noseAngle)) - noseToolMargin
noseToolYHigh = overallWidth / 2 + noseToolX1 * tan(noseAngle) + noseToolMargin
noseToolPlane = offsetPlane(aBuildPlate, offset = -noseToolMargin)
noseToolDepth = actualTopZ + 2 * noseToolMargin
noseLower = sketch(on = noseToolPlane) {
  flank = line(start = [var 7.5mm, var -5mm], end = [var -5mm, var 7.5mm])
  back = line(start = [var -5mm, var 7.5mm], end = [var -5mm, var -10mm])
  bottom = line(start = [var -5mm, var -10mm], end = [var 7.5mm, var -10mm])
  front = line(start = [var 7.5mm, var -10mm], end = [var 7.5mm, var -5mm])
  coincident([flank.end, back.start])
  horizontalDistance([ORIGIN, flank.end]) == noseToolX0
  verticalDistance([ORIGIN, flank.end]) == overallWidth / 2 - (noseToolX0 * tan(noseAngle))
  coincident([back.end, bottom.start])
  horizontalDistance([ORIGIN, back.end]) == noseToolX0
  verticalDistance([ORIGIN, back.end]) == noseToolYLow
  coincident([bottom.end, front.start])
  horizontalDistance([ORIGIN, bottom.end]) == noseToolX1
  verticalDistance([ORIGIN, bottom.end]) == noseToolYLow
  coincident([front.end, flank.start])
  horizontalDistance([ORIGIN, front.end]) == noseToolX1
  verticalDistance([ORIGIN, front.end]) == overallWidth / 2 - (noseToolX1 * tan(noseAngle))
}
noseLowerTool = extrude(region(segments = [noseLower.flank, noseLower.back]), length = noseToolDepth)
bodyWithLowerTaper = subtract(externalPrism, tools = [noseLowerTool])
hide(noseLower)
noseUpper = sketch(on = noseToolPlane) {
  flank = line(start = [var -5mm, var -2.5mm], end = [var 7.5mm, var 10mm])
  front = line(start = [var 7.5mm, var 10mm], end = [var 7.5mm, var 15mm])
  top = line(start = [var 7.5mm, var 15mm], end = [var -5mm, var 15mm])
  back = line(start = [var -5mm, var 15mm], end = [var -5mm, var -2.5mm])
  coincident([flank.end, front.start])
  horizontalDistance([ORIGIN, flank.end]) == noseToolX1
  verticalDistance([ORIGIN, flank.end]) == overallWidth / 2 + noseToolX1 * tan(noseAngle)
  coincident([front.end, top.start])
  horizontalDistance([ORIGIN, front.end]) == noseToolX1
  verticalDistance([ORIGIN, front.end]) == noseToolYHigh
  coincident([top.end, back.start])
  horizontalDistance([ORIGIN, top.end]) == noseToolX0
  verticalDistance([ORIGIN, top.end]) == noseToolYHigh
  coincident([back.end, flank.start])
  horizontalDistance([ORIGIN, back.end]) == noseToolX0
  verticalDistance([ORIGIN, back.end]) == overallWidth / 2 + noseToolX0 * tan(noseAngle)
}
noseUpperTool = extrude(region(segments = [noseUpper.flank, noseUpper.front]), length = noseToolDepth)
externalBody = subtract(bodyWithLowerTaper, tools = [noseUpperTool])
hide(noseUpper)

// Five fully enclosed voids. Exact cutters run from the base to a flat ceiling.
// Keeping five separate tools preserves four walls bonded to base, ceiling,
// and both x end walls. Cutter cap tags become the cavity-facing interfaces.
pocketPlane = offsetPlane(aBuildPlate, offset = l10BaseThickness)

// Pocket 1: nominal x=28.5..32.5, y=0.5..1.2, z=1..5 mm.
pocketSketch1 = sketch(on = pocketPlane) {
  south = line(start = [var 28.5mm, var 0.5mm], end = [var 32.5mm, var 0.5mm])
  east = line(start = [var 32.5mm, var 0.5mm], end = [var 32.5mm, var 1.2mm])
  north = line(start = [var 32.5mm, var 1.2mm], end = [var 28.5mm, var 1.2mm])
  west = line(start = [var 28.5mm, var 1.2mm], end = [var 28.5mm, var 0.5mm])
  coincident([south.end, east.start])
  horizontalDistance([ORIGIN, south.end]) == cavityX1
  verticalDistance([ORIGIN, south.end]) == pocketLow[0]
  coincident([east.end, north.start])
  horizontalDistance([ORIGIN, east.end]) == cavityX1
  verticalDistance([ORIGIN, east.end]) == pocketHigh[0]
  coincident([north.end, west.start])
  horizontalDistance([ORIGIN, north.end]) == cavityX0
  verticalDistance([ORIGIN, north.end]) == pocketHigh[0]
  coincident([west.end, south.start])
  horizontalDistance([ORIGIN, west.end]) == cavityX0
  verticalDistance([ORIGIN, west.end]) == pocketLow[0]
}
pocketRegion1 = region(segments = [
  pocketSketch1.south,
  pocketSketch1.east
])
pocketTool1 = extrude(
  pocketRegion1,
  length = thinWallHeight,
  tagStart = $l10Pocket1Floor,
  tagEnd = $l10Pocket1Ceiling,
)
pocketBody1 = subtract(externalBody, tools = [pocketTool1])
hide(pocketSketch1)

// Pocket 2: nominal x=28.5..32.5, y=1.3..1.9, z=1..5 mm.
pocketSketch2 = sketch(on = pocketPlane) {
  south = line(start = [var 28.5mm, var 1.3mm], end = [var 32.5mm, var 1.3mm])
  east = line(start = [var 32.5mm, var 1.3mm], end = [var 32.5mm, var 1.9mm])
  north = line(start = [var 32.5mm, var 1.9mm], end = [var 28.5mm, var 1.9mm])
  west = line(start = [var 28.5mm, var 1.9mm], end = [var 28.5mm, var 1.3mm])
  coincident([south.end, east.start])
  horizontalDistance([ORIGIN, south.end]) == cavityX1
  verticalDistance([ORIGIN, south.end]) == pocketLow[1]
  coincident([east.end, north.start])
  horizontalDistance([ORIGIN, east.end]) == cavityX1
  verticalDistance([ORIGIN, east.end]) == pocketHigh[1]
  coincident([north.end, west.start])
  horizontalDistance([ORIGIN, north.end]) == cavityX0
  verticalDistance([ORIGIN, north.end]) == pocketHigh[1]
  coincident([west.end, south.start])
  horizontalDistance([ORIGIN, west.end]) == cavityX0
  verticalDistance([ORIGIN, west.end]) == pocketLow[1]
}
pocketRegion2 = region(segments = [
  pocketSketch2.south,
  pocketSketch2.east
])
pocketTool2 = extrude(
  pocketRegion2,
  length = thinWallHeight,
  tagStart = $l10Pocket2Floor,
  tagEnd = $l10Pocket2Ceiling,
)
pocketBody2 = subtract(pocketBody1, tools = [pocketTool2])
hide(pocketSketch2)

// Pocket 3: nominal x=28.5..32.5, y=2.1..2.8, z=1..5 mm.
pocketSketch3 = sketch(on = pocketPlane) {
  south = line(start = [var 28.5mm, var 2.1mm], end = [var 32.5mm, var 2.1mm])
  east = line(start = [var 32.5mm, var 2.1mm], end = [var 32.5mm, var 2.8mm])
  north = line(start = [var 32.5mm, var 2.8mm], end = [var 28.5mm, var 2.8mm])
  west = line(start = [var 28.5mm, var 2.8mm], end = [var 28.5mm, var 2.1mm])
  coincident([south.end, east.start])
  horizontalDistance([ORIGIN, south.end]) == cavityX1
  verticalDistance([ORIGIN, south.end]) == pocketLow[2]
  coincident([east.end, north.start])
  horizontalDistance([ORIGIN, east.end]) == cavityX1
  verticalDistance([ORIGIN, east.end]) == pocketHigh[2]
  coincident([north.end, west.start])
  horizontalDistance([ORIGIN, north.end]) == cavityX0
  verticalDistance([ORIGIN, north.end]) == pocketHigh[2]
  coincident([west.end, south.start])
  horizontalDistance([ORIGIN, west.end]) == cavityX0
  verticalDistance([ORIGIN, west.end]) == pocketLow[2]
}
pocketRegion3 = region(segments = [
  pocketSketch3.south,
  pocketSketch3.east
])
pocketTool3 = extrude(
  pocketRegion3,
  length = thinWallHeight,
  tagStart = $l10Pocket3Floor,
  tagEnd = $l10Pocket3Ceiling,
)
pocketBody3 = subtract(pocketBody2, tools = [pocketTool3])
hide(pocketSketch3)

// Pocket 4: nominal x=28.5..32.5, y=2.9..3.5, z=1..5 mm.
pocketSketch4 = sketch(on = pocketPlane) {
  south = line(start = [var 28.5mm, var 2.9mm], end = [var 32.5mm, var 2.9mm])
  east = line(start = [var 32.5mm, var 2.9mm], end = [var 32.5mm, var 3.5mm])
  north = line(start = [var 32.5mm, var 3.5mm], end = [var 28.5mm, var 3.5mm])
  west = line(start = [var 28.5mm, var 3.5mm], end = [var 28.5mm, var 2.9mm])
  coincident([south.end, east.start])
  horizontalDistance([ORIGIN, south.end]) == cavityX1
  verticalDistance([ORIGIN, south.end]) == pocketLow[3]
  coincident([east.end, north.start])
  horizontalDistance([ORIGIN, east.end]) == cavityX1
  verticalDistance([ORIGIN, east.end]) == pocketHigh[3]
  coincident([north.end, west.start])
  horizontalDistance([ORIGIN, north.end]) == cavityX0
  verticalDistance([ORIGIN, north.end]) == pocketHigh[3]
  coincident([west.end, south.start])
  horizontalDistance([ORIGIN, west.end]) == cavityX0
  verticalDistance([ORIGIN, west.end]) == pocketLow[3]
}
pocketRegion4 = region(segments = [
  pocketSketch4.south,
  pocketSketch4.east
])
pocketTool4 = extrude(
  pocketRegion4,
  length = thinWallHeight,
  tagStart = $l10Pocket4Floor,
  tagEnd = $l10Pocket4Ceiling,
)
pocketBody4 = subtract(pocketBody3, tools = [pocketTool4])
hide(pocketSketch4)

// Pocket 5: nominal x=28.5..32.5, y=3.7..4.5, z=1..5 mm.
pocketSketch5 = sketch(on = pocketPlane) {
  south = line(start = [var 28.5mm, var 3.7mm], end = [var 32.5mm, var 3.7mm])
  east = line(start = [var 32.5mm, var 3.7mm], end = [var 32.5mm, var 4.5mm])
  north = line(start = [var 32.5mm, var 4.5mm], end = [var 28.5mm, var 4.5mm])
  west = line(start = [var 28.5mm, var 4.5mm], end = [var 28.5mm, var 3.7mm])
  coincident([south.end, east.start])
  horizontalDistance([ORIGIN, south.end]) == cavityX1
  verticalDistance([ORIGIN, south.end]) == pocketLow[4]
  coincident([east.end, north.start])
  horizontalDistance([ORIGIN, east.end]) == cavityX1
  verticalDistance([ORIGIN, east.end]) == pocketHigh[4]
  coincident([north.end, west.start])
  horizontalDistance([ORIGIN, north.end]) == cavityX0
  verticalDistance([ORIGIN, north.end]) == pocketHigh[4]
  coincident([west.end, south.start])
  horizontalDistance([ORIGIN, west.end]) == cavityX0
  verticalDistance([ORIGIN, west.end]) == pocketLow[4]
}
pocketRegion5 = region(segments = [
  pocketSketch5.south,
  pocketSketch5.east
])
pocketTool5 = extrude(
  pocketRegion5,
  length = thinWallHeight,
  tagStart = $l10Pocket5Floor,
  tagEnd = $l10Pocket5Ceiling,
)
pocketBody5 = subtract(pocketBody4, tools = [pocketTool5])
hide(pocketSketch5)

bridge = pocketBody5

bridge
