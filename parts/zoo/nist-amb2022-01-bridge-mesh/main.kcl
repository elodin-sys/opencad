@settings(defaultLengthUnit = mm, kclVersion = 2.0)

overallLength = 75mm // stated; +/-0.01 mm
overallWidth = 5mm // stated; +/-0.01 mm
bodyHeight = 12mm // stated; +/-0.01 mm
noseAngle = 45deg // stated; +/-0.1 deg
noseLength = 2.5mm // derived; +/-0.1 mm
legCount = 12 // stated; +/-0.01
largeLegWidth = 5mm // measured; +/-0.1 mm
mediumLegWidth = 2.5mm // measured; +/-0.1 mm
smallLegWidth = 0.5mm // measured; +/-0.1 mm
gapWidth = 2mm // measured; +/-0.1 mm
overhangAngle = 45deg // stated; +/-0.1 deg
legMergeHeight = 7mm // stated; +/-0.01 mm
gapLowHeight = 5mm // derived; +/-0.1 mm
legGroupCount = 4 // derived; +/-0.01
legGroupPitch = 14mm // derived; +/-0.15 mm
endBlockLength = 19mm // derived; +/-0.15 mm
tabCount = 11 // stated; +/-0.01
tabWidth = 1mm // measured; +/-0.1 mm
tabPitch = 7mm // measured; +/-0.1 mm
tabHeight = 0.5mm // measured; +/-0.1 mm
firstTabX = 4mm // derived; +/-0.15 mm
l10StartX = 28mm // derived; +/-0.15 mm
l10OuterWallThickness = 0.5mm // stated; +/-0.1 mm
l10BaseThickness = 1mm // stated; +/-0.01 mm
thinWallHeight = 4mm // stated; +/-0.01 mm
l10CavityLength = 4mm // derived; +/-0.2 mm
l10CavityWidth = 4mm // derived; +/-0.2 mm
l10CavityStartX = 28.5mm // derived; +/-0.15 mm
l10CeilingZ = 5mm // derived; +/-0.02 mm
thinWallCount = 4 // stated; +/-0.01
singleTrackWidth = 0.1mm // INFERRED; +/-0.08 mm
doubleTrackWidth = 0.2mm // INFERRED; +/-0.15 mm
wall1CenterY = 1.25mm // measured; +/-0.2 mm
wall2CenterY = 2mm // measured; +/-0.2 mm
wall3CenterY = 2.85mm // measured; +/-0.2 mm
wall4CenterY = 3.6mm // measured; +/-0.2 mm


// Datums A:z=0, B:y=0, C:x=0, D:x=overallLength.
// Local elevation [u,v] is world [x,z]; its normal is -y.
// Explicit extrusion direction +y establishes the requested min-datum frame.
aBuildPlate = XY
bLongSide = {
  origin = { x = 0mm, y = 0mm, z = 0mm },
  xAxis = { x = 1, y = 0, z = 0 },
  yAxis = { x = 0, y = 0, z = 1 }
}
cTipPlane = YZ
dFarEnd = offsetPlane(YZ, offset = overallLength)
actualTopZ = bodyHeight + tabHeight

// OQ1: Physical track widths are INFERRED (single 0.10 +/-0.08 mm,
// double 0.20 +/-0.15 mm); each double-track member is one physical wall.
// OQ2: Wall centers have +/-0.20 mm image-registration uncertainty.
// OQ3: Alloy/density are unspecified; no mass or powder density is assigned.
// Figure 3 controls the external dimensions. No reference geometry is imported.
// Redundant nominal dimensions are checked externally, never equality-locked.
actualNoseLength = overallWidth / (2 * tan(noseAngle))
actualRoofHighZ = gapLowHeight + gapWidth * tan(overhangAngle)
actualCeilingZ = l10BaseThickness + thinWallHeight
cavityX0 = l10StartX + l10OuterWallThickness
cavityX1 = l10StartX + largeLegWidth - l10OuterWallThickness
cavityY0 = l10OuterWallThickness
cavityY1 = overallWidth - l10OuterWallThickness
cavityLengthActual = cavityX1 - cavityX0
cavityWidthActual = cavityY1 - cavityY0

// Triplets are medium, small, large in +x; gap roofs rise toward +x.
tripletOffsets = [
  0mm,
  gapWidth + mediumLegWidth,
  2 * gapWidth + mediumLegWidth + smallLegWidth
]
allGapStarts = flatten(map(
  [0..<legGroupCount],
  f = fn(@j) {
    return map(
      tripletOffsets,
      f = fn(@d) {
        return endBlockLength + j * legGroupPitch + d
      },
    )
  },
))
gapStarts = slice(allGapStarts, end = legCount)
footStarts = map(
  gapStarts,
  f = fn(@a) {
    return a + gapWidth
  },
)
footEnds = concat(slice(gapStarts, start = 1), items = [overallLength])
tabStarts = map(
  [0..<tabCount],
  f = fn(@i) {
    return firstTabX + i * tabPitch
  },
)
tabEnds = map(
  tabStarts,
  f = fn(@x) {
    return x + tabWidth
  },
)
wallCenters = [
  wall1CenterY,
  wall2CenterY,
  wall3CenterY,
  wall4CenterY
]
trackWidths = [
  singleTrackWidth,
  doubleTrackWidth,
  singleTrackWidth,
  doubleTrackWidth
]
wallLow = map(
  [0..<thinWallCount],
  f = fn(@i) {
    return wallCenters[i] - (trackWidths[i] / 2)
  },
)
wallHigh = map(
  [0..<thinWallCount],
  f = fn(@i) {
    return wallCenters[i] + trackWidths[i] / 2
  },
)
pocketLow = concat([cavityY0], items = wallHigh)
pocketHigh = concat(wallLow, items = [cavityY1])

positiveDimensions = map(
  [
    overallLength,
    overallWidth,
    bodyHeight,
    noseLength,
    largeLegWidth,
    mediumLegWidth,
    smallLegWidth,
    gapWidth,
    legMergeHeight,
    gapLowHeight,
    legGroupPitch,
    endBlockLength,
    tabWidth,
    tabPitch,
    tabHeight,
    firstTabX,
    l10StartX,
    l10OuterWallThickness,
    l10BaseThickness,
    thinWallHeight,
    l10CavityLength,
    l10CavityWidth,
    l10CavityStartX,
    l10CeilingZ,
    singleTrackWidth,
    doubleTrackWidth
  ],
  f = fn(@d) {
    assert(d, isGreaterThan = 0mm)
    return d
  },
)
countChecks = map(
  [
    legCount,
    legGroupCount,
    tabCount,
    thinWallCount
  ],
  f = fn(@n) {
    assert(n, isGreaterThan = 0)
    assertIs(n == floor(n), error = "Counts must be positive integers")
    return n
  },
)
assert(noseAngle, isGreaterThan = 0deg, isLessThan = 90deg)
assert(overhangAngle, isGreaterThan = 0deg, isLessThan = 90deg)
assert(actualNoseLength, isGreaterThan = 0mm, isLessThan = endBlockLength)
assert(noseLength, isLessThan = endBlockLength)
assert(actualRoofHighZ, isLessThan = bodyHeight)
assert(legMergeHeight, isLessThan = bodyHeight)
assert(tabWidth, isLessThan = tabPitch)
assert(firstTabX, isGreaterThan = actualNoseLength)
assert(tabEnds[tabCount - 1], isLessThanOrEqual = overallLength)
assert(2 * l10OuterWallThickness, isLessThan = min([largeLegWidth, overallWidth]))
assert(actualCeilingZ, isLessThan = bodyHeight)
assert(l10CeilingZ, isLessThan = bodyHeight)
assert(l10CavityStartX, isGreaterThan = l10StartX)
assert(l10CavityStartX + l10CavityLength, isLessThan = l10StartX + largeLegWidth)
assert(l10CavityWidth, isLessThan = overallWidth)
assert(cavityX0, isGreaterThan = footStarts[2])
assert(cavityX1, isLessThan = footEnds[2])
footChecks = map(
  [0..<legCount],
  f = fn(@i) {
    assert(footEnds[i] - footStarts[i], isGreaterThan = 0mm)
    return footEnds[i]
  },
)
pocketChecks = map(
  [0..thinWallCount],
  f = fn(@i) {
    assert(pocketHigh[i] - pocketLow[i], isGreaterThan = 0mm)
    return pocketHigh[i]
  },
)

// One native elevation sketch; every vertex is dimensioned from the datum.
// Coincident endpoint handles connect segments without duplicate dimensions.
// The 37 inspection interface names correspond to the nominal 12-foot,
// 11-tab, four-wall topology. Pattern counts determine the placement arrays.
elevation = sketch(on = bLongSide) {
  buildPlateEndBlock = line(start = [var 0mm, var 0mm], end = [var 19mm, var 0mm])
  gap01Left = line(start = [var 19mm, var 0mm], end = [var 19mm, var 5mm])
  gap01Roof = line(start = [var 19mm, var 5mm], end = [var 21mm, var 7mm])
  gap01Right = line(start = [var 21mm, var 7mm], end = [var 21mm, var 0mm])
  buildPlateL12 = line(start = [var 21mm, var 0mm], end = [var 23.5mm, var 0mm])
  gap02Left = line(start = [var 23.5mm, var 0mm], end = [var 23.5mm, var 5mm])
  gap02Roof = line(start = [var 23.5mm, var 5mm], end = [var 25.5mm, var 7mm])
  gap02Right = line(start = [var 25.5mm, var 7mm], end = [var 25.5mm, var 0mm])
  buildPlateL11 = line(start = [var 25.5mm, var 0mm], end = [var 26mm, var 0mm])
  gap03Left = line(start = [var 26mm, var 0mm], end = [var 26mm, var 5mm])
  gap03Roof = line(start = [var 26mm, var 5mm], end = [var 28mm, var 7mm])
  gap03Right = line(start = [var 28mm, var 7mm], end = [var 28mm, var 0mm])
  buildPlateL10 = line(start = [var 28mm, var 0mm], end = [var 33mm, var 0mm])
  gap04Left = line(start = [var 33mm, var 0mm], end = [var 33mm, var 5mm])
  gap04Roof = line(start = [var 33mm, var 5mm], end = [var 35mm, var 7mm])
  gap04Right = line(start = [var 35mm, var 7mm], end = [var 35mm, var 0mm])
  buildPlateL9 = line(start = [var 35mm, var 0mm], end = [var 37.5mm, var 0mm])
  gap05Left = line(start = [var 37.5mm, var 0mm], end = [var 37.5mm, var 5mm])
  gap05Roof = line(start = [var 37.5mm, var 5mm], end = [var 39.5mm, var 7mm])
  gap05Right = line(start = [var 39.5mm, var 7mm], end = [var 39.5mm, var 0mm])
  buildPlateL8 = line(start = [var 39.5mm, var 0mm], end = [var 40mm, var 0mm])
  gap06Left = line(start = [var 40mm, var 0mm], end = [var 40mm, var 5mm])
  gap06Roof = line(start = [var 40mm, var 5mm], end = [var 42mm, var 7mm])
  gap06Right = line(start = [var 42mm, var 7mm], end = [var 42mm, var 0mm])
  buildPlateL7 = line(start = [var 42mm, var 0mm], end = [var 47mm, var 0mm])
  gap07Left = line(start = [var 47mm, var 0mm], end = [var 47mm, var 5mm])
  gap07Roof = line(start = [var 47mm, var 5mm], end = [var 49mm, var 7mm])
  gap07Right = line(start = [var 49mm, var 7mm], end = [var 49mm, var 0mm])
  buildPlateL6 = line(start = [var 49mm, var 0mm], end = [var 51.5mm, var 0mm])
  gap08Left = line(start = [var 51.5mm, var 0mm], end = [var 51.5mm, var 5mm])
  gap08Roof = line(start = [var 51.5mm, var 5mm], end = [var 53.5mm, var 7mm])
  gap08Right = line(start = [var 53.5mm, var 7mm], end = [var 53.5mm, var 0mm])
  buildPlateL5 = line(start = [var 53.5mm, var 0mm], end = [var 54mm, var 0mm])
  gap09Left = line(start = [var 54mm, var 0mm], end = [var 54mm, var 5mm])
  gap09Roof = line(start = [var 54mm, var 5mm], end = [var 56mm, var 7mm])
  gap09Right = line(start = [var 56mm, var 7mm], end = [var 56mm, var 0mm])
  buildPlateL4 = line(start = [var 56mm, var 0mm], end = [var 61mm, var 0mm])
  gap10Left = line(start = [var 61mm, var 0mm], end = [var 61mm, var 5mm])
  gap10Roof = line(start = [var 61mm, var 5mm], end = [var 63mm, var 7mm])
  gap10Right = line(start = [var 63mm, var 7mm], end = [var 63mm, var 0mm])
  buildPlateL3 = line(start = [var 63mm, var 0mm], end = [var 65.5mm, var 0mm])
  gap11Left = line(start = [var 65.5mm, var 0mm], end = [var 65.5mm, var 5mm])
  gap11Roof = line(start = [var 65.5mm, var 5mm], end = [var 67.5mm, var 7mm])
  gap11Right = line(start = [var 67.5mm, var 7mm], end = [var 67.5mm, var 0mm])
  buildPlateL2 = line(start = [var 67.5mm, var 0mm], end = [var 68mm, var 0mm])
  gap12Left = line(start = [var 68mm, var 0mm], end = [var 68mm, var 5mm])
  gap12Roof = line(start = [var 68mm, var 5mm], end = [var 70mm, var 7mm])
  gap12Right = line(start = [var 70mm, var 7mm], end = [var 70mm, var 0mm])
  buildPlateL1 = line(start = [var 70mm, var 0mm], end = [var 75mm, var 0mm])
  farEndX75 = line(start = [var 75mm, var 0mm], end = [var 75mm, var 12.5mm])
  tabTop11 = line(start = [var 75mm, var 12.5mm], end = [var 74mm, var 12.5mm])
  tab11Left = line(start = [var 74mm, var 12.5mm], end = [var 74mm, var 12mm])
  tabValley10 = line(start = [var 74mm, var 12mm], end = [var 68mm, var 12mm])
  tab10Right = line(start = [var 68mm, var 12mm], end = [var 68mm, var 12.5mm])
  tabTop10 = line(start = [var 68mm, var 12.5mm], end = [var 67mm, var 12.5mm])
  tab10Left = line(start = [var 67mm, var 12.5mm], end = [var 67mm, var 12mm])
  tabValley09 = line(start = [var 67mm, var 12mm], end = [var 61mm, var 12mm])
  tab09Right = line(start = [var 61mm, var 12mm], end = [var 61mm, var 12.5mm])
  tabTop09 = line(start = [var 61mm, var 12.5mm], end = [var 60mm, var 12.5mm])
  tab09Left = line(start = [var 60mm, var 12.5mm], end = [var 60mm, var 12mm])
  tabValley08 = line(start = [var 60mm, var 12mm], end = [var 54mm, var 12mm])
  tab08Right = line(start = [var 54mm, var 12mm], end = [var 54mm, var 12.5mm])
  tabTop08 = line(start = [var 54mm, var 12.5mm], end = [var 53mm, var 12.5mm])
  tab08Left = line(start = [var 53mm, var 12.5mm], end = [var 53mm, var 12mm])
  tabValley07 = line(start = [var 53mm, var 12mm], end = [var 47mm, var 12mm])
  tab07Right = line(start = [var 47mm, var 12mm], end = [var 47mm, var 12.5mm])
  tabTop07 = line(start = [var 47mm, var 12.5mm], end = [var 46mm, var 12.5mm])
  tab07Left = line(start = [var 46mm, var 12.5mm], end = [var 46mm, var 12mm])
  tabValley06 = line(start = [var 46mm, var 12mm], end = [var 40mm, var 12mm])
  tab06Right = line(start = [var 40mm, var 12mm], end = [var 40mm, var 12.5mm])
  tabTop06 = line(start = [var 40mm, var 12.5mm], end = [var 39mm, var 12.5mm])
  tab06Left = line(start = [var 39mm, var 12.5mm], end = [var 39mm, var 12mm])
  tabValley05 = line(start = [var 39mm, var 12mm], end = [var 33mm, var 12mm])
  tab05Right = line(start = [var 33mm, var 12mm], end = [var 33mm, var 12.5mm])
  tabTop05 = line(start = [var 33mm, var 12.5mm], end = [var 32mm, var 12.5mm])
  tab05Left = line(start = [var 32mm, var 12.5mm], end = [var 32mm, var 12mm])
  tabValley04 = line(start = [var 32mm, var 12mm], end = [var 26mm, var 12mm])
  tab04Right = line(start = [var 26mm, var 12mm], end = [var 26mm, var 12.5mm])
  tabTop04 = line(start = [var 26mm, var 12.5mm], end = [var 25mm, var 12.5mm])
  tab04Left = line(start = [var 25mm, var 12.5mm], end = [var 25mm, var 12mm])
  tabValley03 = line(start = [var 25mm, var 12mm], end = [var 19mm, var 12mm])
  tab03Right = line(start = [var 19mm, var 12mm], end = [var 19mm, var 12.5mm])
  tabTop03 = line(start = [var 19mm, var 12.5mm], end = [var 18mm, var 12.5mm])
  tab03Left = line(start = [var 18mm, var 12.5mm], end = [var 18mm, var 12mm])
  tabValley02 = line(start = [var 18mm, var 12mm], end = [var 12mm, var 12mm])
  tab02Right = line(start = [var 12mm, var 12mm], end = [var 12mm, var 12.5mm])
  tabTop02 = line(start = [var 12mm, var 12.5mm], end = [var 11mm, var 12.5mm])
  tab02Left = line(start = [var 11mm, var 12.5mm], end = [var 11mm, var 12mm])
  tabValley01 = line(start = [var 11mm, var 12mm], end = [var 5mm, var 12mm])
  tab01Right = line(start = [var 5mm, var 12mm], end = [var 5mm, var 12.5mm])
  tabTop01 = line(start = [var 5mm, var 12.5mm], end = [var 4mm, var 12.5mm])
  tab01Left = line(start = [var 4mm, var 12.5mm], end = [var 4mm, var 12mm])
  noseTop = line(start = [var 4mm, var 12mm], end = [var 0mm, var 12mm])
  tipBeforeTaper = line(start = [var 0mm, var 12mm], end = [var 0mm, var 0mm])
  coincident([
    buildPlateEndBlock.end,
    gap01Left.start
  ])
  horizontalDistance([ORIGIN, buildPlateEndBlock.end]) == endBlockLength
  verticalDistance([ORIGIN, buildPlateEndBlock.end]) == 0mm
  coincident([gap01Left.end, gap01Roof.start])
  horizontalDistance([ORIGIN, gap01Left.end]) == gapStarts[0]
  verticalDistance([ORIGIN, gap01Left.end]) == gapLowHeight
  coincident([gap01Roof.end, gap01Right.start])
  horizontalDistance([ORIGIN, gap01Roof.end]) == footStarts[0]
  verticalDistance([ORIGIN, gap01Roof.end]) == actualRoofHighZ
  coincident([gap01Right.end, buildPlateL12.start])
  horizontalDistance([ORIGIN, gap01Right.end]) == footStarts[0]
  verticalDistance([ORIGIN, gap01Right.end]) == 0mm
  coincident([buildPlateL12.end, gap02Left.start])
  horizontalDistance([ORIGIN, buildPlateL12.end]) == footEnds[0]
  verticalDistance([ORIGIN, buildPlateL12.end]) == 0mm
  coincident([gap02Left.end, gap02Roof.start])
  horizontalDistance([ORIGIN, gap02Left.end]) == gapStarts[1]
  verticalDistance([ORIGIN, gap02Left.end]) == gapLowHeight
  coincident([gap02Roof.end, gap02Right.start])
  horizontalDistance([ORIGIN, gap02Roof.end]) == footStarts[1]
  verticalDistance([ORIGIN, gap02Roof.end]) == actualRoofHighZ
  coincident([gap02Right.end, buildPlateL11.start])
  horizontalDistance([ORIGIN, gap02Right.end]) == footStarts[1]
  verticalDistance([ORIGIN, gap02Right.end]) == 0mm
  coincident([buildPlateL11.end, gap03Left.start])
  horizontalDistance([ORIGIN, buildPlateL11.end]) == footEnds[1]
  verticalDistance([ORIGIN, buildPlateL11.end]) == 0mm
  coincident([gap03Left.end, gap03Roof.start])
  horizontalDistance([ORIGIN, gap03Left.end]) == gapStarts[2]
  verticalDistance([ORIGIN, gap03Left.end]) == gapLowHeight
  coincident([gap03Roof.end, gap03Right.start])
  horizontalDistance([ORIGIN, gap03Roof.end]) == footStarts[2]
  verticalDistance([ORIGIN, gap03Roof.end]) == actualRoofHighZ
  coincident([gap03Right.end, buildPlateL10.start])
  horizontalDistance([ORIGIN, gap03Right.end]) == footStarts[2]
  verticalDistance([ORIGIN, gap03Right.end]) == 0mm
  coincident([buildPlateL10.end, gap04Left.start])
  horizontalDistance([ORIGIN, buildPlateL10.end]) == footEnds[2]
  verticalDistance([ORIGIN, buildPlateL10.end]) == 0mm
  coincident([gap04Left.end, gap04Roof.start])
  horizontalDistance([ORIGIN, gap04Left.end]) == gapStarts[3]
  verticalDistance([ORIGIN, gap04Left.end]) == gapLowHeight
  coincident([gap04Roof.end, gap04Right.start])
  horizontalDistance([ORIGIN, gap04Roof.end]) == footStarts[3]
  verticalDistance([ORIGIN, gap04Roof.end]) == actualRoofHighZ
  coincident([gap04Right.end, buildPlateL9.start])
  horizontalDistance([ORIGIN, gap04Right.end]) == footStarts[3]
  verticalDistance([ORIGIN, gap04Right.end]) == 0mm
  coincident([buildPlateL9.end, gap05Left.start])
  horizontalDistance([ORIGIN, buildPlateL9.end]) == footEnds[3]
  verticalDistance([ORIGIN, buildPlateL9.end]) == 0mm
  coincident([gap05Left.end, gap05Roof.start])
  horizontalDistance([ORIGIN, gap05Left.end]) == gapStarts[4]
  verticalDistance([ORIGIN, gap05Left.end]) == gapLowHeight
  coincident([gap05Roof.end, gap05Right.start])
  horizontalDistance([ORIGIN, gap05Roof.end]) == footStarts[4]
  verticalDistance([ORIGIN, gap05Roof.end]) == actualRoofHighZ
  coincident([gap05Right.end, buildPlateL8.start])
  horizontalDistance([ORIGIN, gap05Right.end]) == footStarts[4]
  verticalDistance([ORIGIN, gap05Right.end]) == 0mm
  coincident([buildPlateL8.end, gap06Left.start])
  horizontalDistance([ORIGIN, buildPlateL8.end]) == footEnds[4]
  verticalDistance([ORIGIN, buildPlateL8.end]) == 0mm
  coincident([gap06Left.end, gap06Roof.start])
  horizontalDistance([ORIGIN, gap06Left.end]) == gapStarts[5]
  verticalDistance([ORIGIN, gap06Left.end]) == gapLowHeight
  coincident([gap06Roof.end, gap06Right.start])
  horizontalDistance([ORIGIN, gap06Roof.end]) == footStarts[5]
  verticalDistance([ORIGIN, gap06Roof.end]) == actualRoofHighZ
  coincident([gap06Right.end, buildPlateL7.start])
  horizontalDistance([ORIGIN, gap06Right.end]) == footStarts[5]
  verticalDistance([ORIGIN, gap06Right.end]) == 0mm
  coincident([buildPlateL7.end, gap07Left.start])
  horizontalDistance([ORIGIN, buildPlateL7.end]) == footEnds[5]
  verticalDistance([ORIGIN, buildPlateL7.end]) == 0mm
  coincident([gap07Left.end, gap07Roof.start])
  horizontalDistance([ORIGIN, gap07Left.end]) == gapStarts[6]
  verticalDistance([ORIGIN, gap07Left.end]) == gapLowHeight
  coincident([gap07Roof.end, gap07Right.start])
  horizontalDistance([ORIGIN, gap07Roof.end]) == footStarts[6]
  verticalDistance([ORIGIN, gap07Roof.end]) == actualRoofHighZ
  coincident([gap07Right.end, buildPlateL6.start])
  horizontalDistance([ORIGIN, gap07Right.end]) == footStarts[6]
  verticalDistance([ORIGIN, gap07Right.end]) == 0mm
  coincident([buildPlateL6.end, gap08Left.start])
  horizontalDistance([ORIGIN, buildPlateL6.end]) == footEnds[6]
  verticalDistance([ORIGIN, buildPlateL6.end]) == 0mm
  coincident([gap08Left.end, gap08Roof.start])
  horizontalDistance([ORIGIN, gap08Left.end]) == gapStarts[7]
  verticalDistance([ORIGIN, gap08Left.end]) == gapLowHeight
  coincident([gap08Roof.end, gap08Right.start])
  horizontalDistance([ORIGIN, gap08Roof.end]) == footStarts[7]
  verticalDistance([ORIGIN, gap08Roof.end]) == actualRoofHighZ
  coincident([gap08Right.end, buildPlateL5.start])
  horizontalDistance([ORIGIN, gap08Right.end]) == footStarts[7]
  verticalDistance([ORIGIN, gap08Right.end]) == 0mm
  coincident([buildPlateL5.end, gap09Left.start])
  horizontalDistance([ORIGIN, buildPlateL5.end]) == footEnds[7]
  verticalDistance([ORIGIN, buildPlateL5.end]) == 0mm
  coincident([gap09Left.end, gap09Roof.start])
  horizontalDistance([ORIGIN, gap09Left.end]) == gapStarts[8]
  verticalDistance([ORIGIN, gap09Left.end]) == gapLowHeight
  coincident([gap09Roof.end, gap09Right.start])
  horizontalDistance([ORIGIN, gap09Roof.end]) == footStarts[8]
  verticalDistance([ORIGIN, gap09Roof.end]) == actualRoofHighZ
  coincident([gap09Right.end, buildPlateL4.start])
  horizontalDistance([ORIGIN, gap09Right.end]) == footStarts[8]
  verticalDistance([ORIGIN, gap09Right.end]) == 0mm
  coincident([buildPlateL4.end, gap10Left.start])
  horizontalDistance([ORIGIN, buildPlateL4.end]) == footEnds[8]
  verticalDistance([ORIGIN, buildPlateL4.end]) == 0mm
  coincident([gap10Left.end, gap10Roof.start])
  horizontalDistance([ORIGIN, gap10Left.end]) == gapStarts[9]
  verticalDistance([ORIGIN, gap10Left.end]) == gapLowHeight
  coincident([gap10Roof.end, gap10Right.start])
