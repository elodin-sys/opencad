@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// NIST AM test artifact. Datum A is z=0; all dimensions are editable.
// Literal contract parameters; derived reference sizes are used only for clearance checks.
baseSide = 100mm
baseRotation = 45deg
baseThickness = 10mm
baseHalfDiagonal = 70.71067811865474mm
mainPinDiameter = 4mm
mainPinHeight = 7mm
pinFirstRadius = 20mm
pinPitch = 10mm
pinsPerArm = 4
mainHoleDiameter = 4mm
mainHoleRadius = 60mm
centerHoleDiameter = 10mm
lowerBossDiameter = 20mm
lowerBossHeight = 4mm
upperBossDiameter = 15mm
upperBossHeight = 3mm
stairInnerOffset = 12mm
stairTread = 10mm
stairFirstHeight = 3mm
stairIncrement = 1mm
rampLowHeight = 1mm
rampRise = 1mm
rampRun = 25mm
rampLanding = 2.5mm
rampWidth = 5mm
rampStartRadius = 15mm
fineHeightDepth = 2mm
fineSizeA = 2mm
fineSizeB = 1.5mm
fineSizeC = 1mm
fineSizeD = 0.5mm
fineSizeE = 0.25mm
fineFirstX = 28.284mm
fineFirstY = 21.213mm
finePitch = 5mm
rectOuterInset = 1mm
rectLengthRatio = 3
rectStartV1 = 2mm
rectStartV2 = 6mm
rectStartV3 = 11mm
rectStartV4 = 14mm
rectStartV5 = 17.5mm
rectStartV6 = 19.5mm
rectStartV7 = 22mm
rectStartV8 = 23mm
rectStartV9 = 24.5mm
rectStartV10 = 25mm
lateralCenterZ = -5mm
lateralFirstStation = 40mm
lateralPitch = 10mm
lateralSmallDiameter = 3mm
lateralSmallDepth = 3mm
lateralLargeDiameter = 6mm
lateralLargeDepth = 5mm
lateralSmallSquare = 3mm
lateralLargeSquare = 6mm
lateralSmallDiamond = 3mm
lateralSmallDiamondDepth = 3mm
lateralLargeDiamond = 6mm
lateralTallHeight = 6mm
lateralWideHeight = 4mm
lateralApexAngle = 60deg
lateralTallWidth = 3.4641016151377535mm
lateralWideWidth = 6.9282032302755105mm

// Scalar diagonal coordinates: eu cross ev = -Z.
eu = [
  cos(baseRotation),
  sin(baseRotation),
  0
]
ev = [
  sin(baseRotation),
  -cos(baseRotation),
  0
]
epsilon = fineSizeE / 10
halfSide = baseSide / 2

fn xy(@u, v) {
  return [
    u * eu[0] + v * ev[0],
    u * eu[1] + v * ev[1]
  ]
}

// Sanity and clearance guards; no equality locks between contract parameters.
assert(
  min([
    baseSide,
    baseThickness,
    baseHalfDiagonal,
    mainPinDiameter,
    mainPinHeight,
    pinFirstRadius,
    pinPitch,
    mainHoleDiameter,
    mainHoleRadius,
    centerHoleDiameter,
    lowerBossDiameter,
    lowerBossHeight,
    upperBossDiameter,
    upperBossHeight,
    stairInnerOffset,
    stairTread,
    stairFirstHeight,
    stairIncrement,
    rampLowHeight,
    rampRise,
    rampRun,
    rampLanding,
    rampWidth,
    rampStartRadius,
    fineHeightDepth,
    fineSizeA,
    fineSizeB,
    fineSizeC,
    fineSizeD,
    fineSizeE,
    fineFirstX,
    fineFirstY,
    finePitch,
    rectOuterInset,
    rectStartV1,
    rectStartV2,
    rectStartV3,
    rectStartV4,
    rectStartV5,
    rectStartV6,
    rectStartV7,
    rectStartV8,
    rectStartV9,
    rectStartV10,
    lateralFirstStation,
    lateralPitch,
    lateralSmallDiameter,
    lateralSmallDepth,
    lateralLargeDiameter,
    lateralLargeDepth,
    lateralSmallSquare,
    lateralLargeSquare,
    lateralSmallDiamond,
    lateralSmallDiamondDepth,
    lateralLargeDiamond,
    lateralTallHeight,
    lateralWideHeight,
    lateralTallWidth,
    lateralWideWidth
  ]),
  isGreaterThan = 0mm,
  error = "Dimensions and reference clearances must be positive",
)
assert(pinsPerArm, isGreaterThan = 0, error = "Each pin arm needs at least one pin")
assertIs(pinsPerArm == floor(pinsPerArm), error = "pinsPerArm must be integral")
assert(rectLengthRatio, isGreaterThan = 0)
assert(baseRotation, isGreaterThan = 0deg, isLessThan = 90deg)
assert(lateralApexAngle, isGreaterThan = 0deg, isLessThan = 90deg)
assert(lowerBossDiameter, isGreaterThan = upperBossDiameter)
assert(upperBossDiameter, isGreaterThan = centerHoleDiameter)
assert(baseThickness, isGreaterThan = stairFirstHeight + 4 * stairIncrement)
assert(baseThickness, isGreaterThan = fineHeightDepth)
assert(mainPinDiameter, isLessThan = pinPitch)
assert(pinFirstRadius - (mainPinDiameter / 2), isGreaterThan = lowerBossDiameter / 2)
assert(pinFirstRadius + (pinsPerArm - 1) * pinPitch + mainPinDiameter / 2, isLessThan = mainHoleRadius - (mainHoleDiameter / 2))
// The three rounded derived constants are references, never independent shape drivers.
assert(baseHalfDiagonal, isGreaterThan = mainHoleRadius + mainHoleDiameter / 2)
assert(baseHalfDiagonal, isGreaterThan = stairInnerOffset + 3 * stairTread)
assert(max([lateralTallWidth, lateralWideWidth]), isLessThan = lateralPitch)
assert(rampStartRadius, isGreaterThan = lowerBossDiameter / 2)
assert(rampStartRadius + rampRun + 2 * rampLanding, isLessThan = halfSide)
assert(rampWidth / 2, isLessThan = halfSide)
assert(rectOuterInset + rectLengthRatio * fineSizeA, isLessThan = halfSide)
assert(finePitch, isGreaterThan = fineSizeA)
assert(fineSizeA, isGreaterThan = fineSizeB)
assert(fineSizeB, isGreaterThan = fineSizeC)
assert(fineSizeC, isGreaterThan = fineSizeD)
assert(fineSizeD, isGreaterThan = fineSizeE)
assert(lowerBossDiameter / 2, isLessThan = halfSide)
axisProjection = max([
  abs(eu[0]),
  abs(eu[1]),
  abs(ev[0]),
  abs(ev[1])
])
assert(mainHoleRadius * axisProjection + mainHoleDiameter / 2, isLessThan = halfSide)
assert((pinFirstRadius + (pinsPerArm - 1) * pinPitch) * axisProjection + mainPinDiameter / 2, isLessThan = halfSide)
fn containedXy(@point, padding) {
  assert(abs(point[0] * eu[0] + point[1] * eu[1]) + padding, isLessThan = halfSide)
  assert(abs(point[0] * ev[0] + point[1] * ev[1]) + padding, isLessThan = halfSide)
  return 0
}
containedXy(
  [
    -stairInnerOffset - (3 * stairTread),
    stairInnerOffset
  ],
  padding = 0mm,
)
containedXy(
  [
    -stairInnerOffset - (3 * stairTread),
    -stairInnerOffset
  ],
  padding = 0mm,
)
containedXy([-stairInnerOffset, stairInnerOffset], padding = 0mm)
containedXy([-stairInnerOffset, -stairInnerOffset], padding = 0mm)
containedXy(
  [
    -stairInnerOffset,
    stairInnerOffset + 3 * stairTread
  ],
  padding = 0mm,
)
containedXy(
  [
    -stairInnerOffset,
    -(stairInnerOffset + 3 * stairTread)
  ],
  padding = 0mm,
)
containedXy(
  [
    -stairInnerOffset - stairTread,
    stairInnerOffset + 3 * stairTread
  ],
  padding = 0mm,
)
containedXy(
  [
    -stairInnerOffset - stairTread,
    -(stairInnerOffset + 3 * stairTread)
  ],
  padding = 0mm,
)
containedXy(
  [
    -stairInnerOffset - stairTread,
    stairInnerOffset + stairTread
  ],
  padding = 0mm,
)
containedXy(
  [
    -stairInnerOffset - stairTread,
    -(stairInnerOffset + stairTread)
  ],
  padding = 0mm,
)
containedXy(
  [
    -stairInnerOffset - (3 * stairTread),
    stairInnerOffset + stairTread
  ],
  padding = 0mm,
)
containedXy(
  [
    -stairInnerOffset - (3 * stairTread),
    -(stairInnerOffset + stairTread)
  ],
  padding = 0mm,
)
containedXy(
  [
    fineFirstX + 0 * finePitch * ev[0],
    fineFirstY + 0 * finePitch * ev[1]
  ],
  padding = fineSizeA / 2,
)
containedXy(
  [
    fineFirstX + 1 * finePitch * ev[0],
    fineFirstY + 1 * finePitch * ev[1]
  ],
  padding = fineSizeB / 2,
)
containedXy(
  [
    fineFirstX + 2 * finePitch * ev[0],
    fineFirstY + 2 * finePitch * ev[1]
  ],
  padding = fineSizeC / 2,
)
containedXy(
  [
    fineFirstX + 3 * finePitch * ev[0],
    fineFirstY + 3 * finePitch * ev[1]
  ],
  padding = fineSizeD / 2,
)
containedXy(
  [
    fineFirstX + 4 * finePitch * ev[0],
    fineFirstY + 4 * finePitch * ev[1]
  ],
  padding = fineSizeE / 2,
)
assert(rectStartV1 + fineSizeA, isLessThan = halfSide)
assert(rectStartV2, isGreaterThan = rectStartV1 + fineSizeA)
assert(rectStartV2 + fineSizeA, isLessThan = halfSide)
assert(rectStartV3, isGreaterThan = rectStartV2 + fineSizeA)
assert(rectStartV3 + fineSizeB, isLessThan = halfSide)
assert(rectStartV4, isGreaterThan = rectStartV3 + fineSizeB)
assert(rectStartV4 + fineSizeB, isLessThan = halfSide)
assert(rectStartV5, isGreaterThan = rectStartV4 + fineSizeB)
assert(rectStartV5 + fineSizeC, isLessThan = halfSide)
assert(rectStartV6, isGreaterThan = rectStartV5 + fineSizeC)
assert(rectStartV6 + fineSizeC, isLessThan = halfSide)
assert(rectStartV7, isGreaterThan = rectStartV6 + fineSizeC)
assert(rectStartV7 + fineSizeD, isLessThan = halfSide)
assert(rectStartV8, isGreaterThan = rectStartV7 + fineSizeD)
assert(rectStartV8 + fineSizeD, isLessThan = halfSide)
assert(rectStartV9, isGreaterThan = rectStartV8 + fineSizeD)
assert(rectStartV9 + fineSizeE, isLessThan = halfSide)
assert(rectStartV10, isGreaterThan = rectStartV9 + fineSizeE)
assert(rectStartV10 + fineSizeE, isLessThan = halfSide)
assert(abs(lateralFirstStation - (0 * lateralPitch)) + lateralSmallDiameter / 2, isLessThan = halfSide)
assert(lateralCenterZ + lateralSmallDiameter / 2, isLessThan = 0mm)
assert(lateralCenterZ - (lateralSmallDiameter / 2), isGreaterThan = -baseThickness)
assert(lateralSmallDepth, isLessThan = halfSide)
assert(lateralPitch, isGreaterThan = (lateralSmallDiameter + lateralSmallSquare) / 2)
assert(abs(lateralFirstStation - (1 * lateralPitch)) + lateralSmallSquare / 2, isLessThan = halfSide)
assert(lateralCenterZ + lateralSmallSquare / 2, isLessThan = 0mm)
assert(lateralCenterZ - (lateralSmallSquare / 2), isGreaterThan = -baseThickness)
assert(lateralSmallDepth, isLessThan = halfSide)
assert(lateralPitch, isGreaterThan = (lateralSmallSquare + lateralSmallDiamond) / 2)
assert(abs(lateralFirstStation - (2 * lateralPitch)) + lateralSmallDiamond / 2, isLessThan = halfSide)
assert(lateralCenterZ + lateralSmallDiamond / 2, isLessThan = 0mm)
assert(lateralCenterZ - (lateralSmallDiamond / 2), isGreaterThan = -baseThickness)
assert(lateralSmallDiamondDepth, isLessThan = halfSide)
assert(lateralPitch, isGreaterThan = (lateralSmallDiamond + lateralLargeDiameter) / 2)
assert(abs(lateralFirstStation - (3 * lateralPitch)) + lateralLargeDiameter / 2, isLessThan = halfSide)
assert(lateralCenterZ + lateralLargeDiameter / 2, isLessThan = 0mm)
assert(lateralCenterZ - (lateralLargeDiameter / 2), isGreaterThan = -baseThickness)
assert(lateralLargeDepth, isLessThan = halfSide)
assert(lateralPitch, isGreaterThan = (lateralLargeDiameter + lateralLargeSquare) / 2)
assert(abs(lateralFirstStation - (4 * lateralPitch)) + lateralLargeSquare / 2, isLessThan = halfSide)
assert(lateralCenterZ + lateralLargeSquare / 2, isLessThan = 0mm)
assert(lateralCenterZ - (lateralLargeSquare / 2), isGreaterThan = -baseThickness)
assert(lateralLargeDepth, isLessThan = halfSide)
assert(lateralPitch, isGreaterThan = (lateralLargeSquare + lateralLargeDiamond) / 2)
assert(abs(lateralFirstStation - (5 * lateralPitch)) + lateralLargeDiamond / 2, isLessThan = halfSide)
assert(lateralCenterZ + lateralLargeDiamond / 2, isLessThan = 0mm)
assert(lateralCenterZ - (lateralLargeDiamond / 2), isGreaterThan = -baseThickness)
assert(lateralLargeDepth, isLessThan = halfSide)
assert(lateralPitch, isGreaterThan = (lateralLargeDiamond + lateralTallHeight * tan(lateralApexAngle / 2)) / 2)
assert(abs(lateralFirstStation - (6 * lateralPitch)) + lateralTallHeight * tan(lateralApexAngle / 2) / 2, isLessThan = halfSide)
assert(lateralCenterZ + lateralTallHeight / 2, isLessThan = 0mm)
assert(lateralCenterZ - (lateralTallHeight / 2), isGreaterThan = -baseThickness)
assert(lateralLargeDepth, isLessThan = halfSide)
assert(lateralPitch, isGreaterThan = (lateralTallHeight * tan(lateralApexAngle / 2) + lateralWideHeight / tan(lateralApexAngle / 2)) / 2)
assert(abs(lateralFirstStation - (7 * lateralPitch)) + lateralWideHeight / tan(lateralApexAngle / 2) / 2, isLessThan = halfSide)
assert(lateralCenterZ + lateralWideHeight / 2, isLessThan = 0mm)
assert(lateralCenterZ - (lateralWideHeight / 2), isGreaterThan = -baseThickness)
assert(lateralLargeDepth, isLessThan = halfSide)

// Step 1: local square, transformed into the diamond's exact datum plane.
// Compact local coordinates avoid inflated raw-sketch bounds in the CLI.
basePlane = {
  origin = { x = 0mm, y = 0mm, z = 0mm },
  xAxis = { x = eu[0], y = eu[1], z = 0 },
  yAxis = { x = -ev[0], y = -ev[1], z = 0 }
}
baseSketch = sketch(on = basePlane) {
  sideNorthEast = line(start = [halfSide, -halfSide], end = [halfSide, halfSide])
  sideNorthWest = line(start = [halfSide, halfSide], end = [-halfSide, halfSide])
  sideSouthWest = line(start = [-halfSide, halfSide], end = [-halfSide, -halfSide])
  sideSouthEast = line(start = [-halfSide, -halfSide], end = [halfSide, -halfSide])
}
baseRegion = region(segments = [
  baseSketch.sideNorthEast,
  baseSketch.sideNorthWest
])
diamondBase = extrude(
  baseRegion,
  length = -baseThickness,
  tagStart = $baseBottom,
  tagEnd = $datumA,
)

// Convert a global XY point into the queried horizontal face's local coordinates.
fn faceXy(@point, plane) {
  dx = point[0] - plane.origin[0]
  dy = point[1] - plane.origin[1]
  return [
    (dx * plane.xAxis[0] + dy * plane.xAxis[1]): mm,
    (dx * plane.yAxis[0] + dy * plane.yAxis[1]): mm
  ]
}

// Step 2: central bosses, merged by native face extrusion.
aPlane = planeOf(diamondBase, face = datumA)
lowerSketch = sketch(on = faceOf(diamondBase, face = datumA)) {
  lowerCircle = circle(center = faceXy([0mm, 0mm], plane = aPlane), start = faceXy([lowerBossDiameter / 2, 0mm], plane = aPlane))
}
lowerRegion = region(segments = [lowerSketch.lowerCircle])
withLowerBoss = extrude(lowerRegion, length = lowerBossHeight, tagEnd = $lowerBossCap)
upperPlane = planeOf(withLowerBoss, face = lowerBossCap)
upperSketch = sketch(on = faceOf(withLowerBoss, face = lowerBossCap)) {
  upperCircle = circle(center = faceXy([0mm, 0mm], plane = upperPlane), start = faceXy([upperBossDiameter / 2, 0mm], plane = upperPlane))
}
upperRegion = region(segments = [upperSketch.upperCircle])
withCentralBosses = extrude(upperRegion, length = upperBossHeight, tagEnd = $upperBossCap)
centerBoreSketch = sketch(on = offsetPlane(XY, offset = -baseThickness - epsilon)) {
  centerBore = circle(center = [0mm, 0mm], start = [centerHoleDiameter / 2, 0mm])
}
centerBoreRegion = region(segments = [centerBoreSketch.centerBore])
centerBoreTool = extrude(centerBoreRegion, length = baseThickness + lowerBossHeight + upperBossHeight + 2 * epsilon)
withCenterBore = subtract(withCentralBosses, tools = [centerBoreTool])

// Step 3: the +X datum hole and its three axis companions.
mainHoleSketch = sketch(on = offsetPlane(XY, offset = -baseThickness - epsilon)) {
  datumC = circle(
    center = [mainHoleRadius, 0mm],
    start = [
      mainHoleRadius + mainHoleDiameter / 2,
      0mm
    ],
  )
}
mainHoleRegion = region(segments = [mainHoleSketch.datumC])
mainHoleTool = extrude(mainHoleRegion, length = baseThickness + 2 * epsilon)
mainHoleTools = patternCircular3d(
  mainHoleTool,
  instances = 4,
  axis = Z,
  center = [0mm, 0mm, 0mm],
  arcDegrees = 360deg,
)
withDatumHoles = subtract(withCenterBore, tools = mainHoleTools)
hide([
  baseRegion,
  lowerRegion,
  upperRegion,
  centerBoreRegion,
  mainHoleRegion
])
hide([aPlane, upperPlane, basePlane, XY])

// Step 4: pattern only the small pin body, never the plate.
mainPinSketch = sketch(on = offsetPlane(XY, offset = -epsilon)) {
  mainPin = circle(
    center = [pinFirstRadius, 0mm],
    start = [
      pinFirstRadius + mainPinDiameter / 2,
      0mm
    ],
  )
}
mainPinRegion = region(segments = [mainPinSketch.mainPin])
mainPinSeed = extrude(mainPinRegion, length = mainPinHeight + epsilon, tagEnd = $mainPinCap)
pinArm = patternLinear3d(
  mainPinSeed,
  instances = pinsPerArm,
  distance = pinPitch,
  axis = X,
)
mainPins = patternCircular3d(
  pinArm,
  instances = 4,
  axis = Z,
  center = [0mm, 0mm, 0mm],
  arcDegrees = 360deg,
)
withMainPins = union(concat([withDatumHoles], items = mainPins))
hide(mainPinRegion)

// Steps 5 and 6: construct each L as one prism and trim four end bands.
// The full-prism method avoids native layered extrusions leaving contact solids.
a = stairInnerOffset
t = stairTread
stairTop = stairFirstHeight + 4 * stairIncrement
raisedStairBlankSketch = sketch(on = offsetPlane(XY, offset = -epsilon)) {
  edge1 = line(start = [-a - (3 * t), a], end = [-a, a])
  edge2 = line(start = [-a, a], end = [-a, a + 3 * t])
  edge3 = line(start = [-a, a + 3 * t], end = [-a - t, a + 3 * t])
  edge4 = line(start = [-a - t, a + 3 * t], end = [-a - t, a + t])
  edge5 = line(start = [-a - t, a + t], end = [-a - (3 * t), a + t])
  edge6 = line(start = [-a - (3 * t), a + t], end = [-a - (3 * t), a])
}
raisedStairBlankRegion = region(segments = [
  raisedStairBlankSketch.edge1,
  raisedStairBlankSketch.edge2
])
raisedStairBlank = extrude(raisedStairBlankRegion, length = stairTop + epsilon, tagEnd = $raisedElbowCap)
raisedTrimOuterxSketch = sketch(on = offsetPlane(XY, offset = stairFirstHeight + 0 * stairIncrement)) {
  edge1 = line(start = [-a - (3 * t) - epsilon, a - epsilon], end = [-a - (2 * t), a - epsilon])
  edge2 = line(start = [-a - (2 * t), a - epsilon], end = [-a - (2 * t), a + t + epsilon])
  edge3 = line(
    start = [-a - (2 * t), a + t + epsilon],
    end = [
      -a - (3 * t) - epsilon,
      a + t + epsilon
    ],
  )
  edge4 = line(
    start = [
      -a - (3 * t) - epsilon,
      a + t + epsilon
    ],
    end = [-a - (3 * t) - epsilon, a - epsilon],
  )
}
raisedTrimOuterxRegion = region(segments = [
  raisedTrimOuterxSketch.edge1,
  raisedTrimOuterxSketch.edge2
])
raisedTrimOuterxTool = extrude(raisedTrimOuterxRegion, length = 4 * stairIncrement + epsilon)
raisedStairTrim1 = subtract(raisedStairBlank, tools = [raisedTrimOuterxTool])
raisedTrimOuterySketch = sketch(on = offsetPlane(XY, offset = stairFirstHeight + 1 * stairIncrement)) {
  edge1 = line(start = [-a - t - epsilon, a + 2 * t], end = [-a + epsilon, a + 2 * t])
  edge2 = line(start = [-a + epsilon, a + 2 * t], end = [-a + epsilon, a + 3 * t + epsilon])
  edge3 = line(start = [-a + epsilon, a + 3 * t + epsilon], end = [-a - t - epsilon, a + 3 * t + epsilon])
  edge4 = line(start = [-a - t - epsilon, a + 3 * t + epsilon], end = [-a - t - epsilon, a + 2 * t])
}
raisedTrimOuteryRegion = region(segments = [
  raisedTrimOuterySketch.edge1,
  raisedTrimOuterySketch.edge2
])
raisedTrimOuteryTool = extrude(raisedTrimOuteryRegion, length = 3 * stairIncrement + epsilon)
raisedStairTrim2 = subtract(raisedStairTrim1, tools = [raisedTrimOuteryTool])
raisedTrimMiddlexSketch = sketch(on = offsetPlane(XY, offset = stairFirstHeight + 2 * stairIncrement)) {
  edge1 = line(start = [-a - (3 * t) - epsilon, a - epsilon], end = [-a - t, a - epsilon])
  edge2 = line(start = [-a - t, a - epsilon], end = [-a - t, a + t])
  edge3 = line(start = [-a - t, a + t], end = [-a - t - epsilon, a + t + epsilon])
  edge4 = line(
    start = [-a - t - epsilon, a + t + epsilon],
    end = [
      -a - (3 * t) - epsilon,
      a + t + epsilon
    ],
  )
  edge5 = line(
    start = [
      -a - (3 * t) - epsilon,
      a + t + epsilon
    ],
    end = [-a - (3 * t) - epsilon, a - epsilon],
  )
}
raisedTrimMiddlexRegion = region(segments = [
  raisedTrimMiddlexSketch.edge1,
  raisedTrimMiddlexSketch.edge2
])
raisedTrimMiddlexTool = extrude(raisedTrimMiddlexRegion, length = 2 * stairIncrement + epsilon)
raisedStairTrim3 = subtract(raisedStairTrim2, tools = [raisedTrimMiddlexTool])
raisedTrimMiddleySketch = sketch(on = offsetPlane(XY, offset = stairFirstHeight + 3 * stairIncrement)) {
  edge1 = line(start = [-a - (3 * t) - epsilon, a + t], end = [-a + epsilon, a + t])
  edge2 = line(start = [-a + epsilon, a + t], end = [-a + epsilon, a + 3 * t + epsilon])
  edge3 = line(
    start = [-a + epsilon, a + 3 * t + epsilon],
    end = [
      -a - (3 * t) - epsilon,
      a + 3 * t + epsilon
    ],
  )
  edge4 = line(
    start = [
      -a - (3 * t) - epsilon,
      a + 3 * t + epsilon
    ],
    end = [-a - (3 * t) - epsilon, a + t],
  )
}
raisedTrimMiddleyRegion = region(segments = [
  raisedTrimMiddleySketch.edge1,
  raisedTrimMiddleySketch.edge2
])
raisedTrimMiddleyTool = extrude(raisedTrimMiddleyRegion, length = 1 * stairIncrement + epsilon)
raisedStairTrim4 = subtract(raisedStairTrim3, tools = [raisedTrimMiddleyTool])
// Reflect the completed tool across y=0 and z=0 in one proper rotation.
recessedStairTool = clone(raisedStairTrim4)
  |> rotate(roll = 180deg)
withRaisedStair = union([withMainPins, raisedStairTrim4])
withStaircases = subtract(withRaisedStair, tools = [recessedStairTool])
hide([
  raisedStairBlankRegion,
  raisedTrimOuterxRegion,
  raisedTrimOuteryRegion,
  raisedTrimMiddlexRegion,
  raisedTrimMiddleyRegion
])

// Step 7: exact ramp side section. Axes (ev,+Z) have normal -eu.
r0 = rampStartRadius
r1 = r0 + rampLanding
r2 = r1 + rampRun
r3 = r2 + rampLanding
hLow = rampLowHeight
hHigh = rampLowHeight + rampRise
rampPlane = {
  origin = {
    x = eu[0] * rampWidth / 2,
    y = eu[1] * rampWidth / 2,
    z = 0mm
  },
  xAxis = { x = ev[0], y = ev[1], z = 0 },
  yAxis = { x = 0, y = 0, z = 1 }
}
rampSketch = sketch(on = rampPlane) {
  root = line(start = [r0, -epsilon], end = [r3, -epsilon])
  lowEnd = line(start = [r3, -epsilon], end = [r3, hLow])
  lowLanding = line(start = [r3, hLow], end = [r2, hLow])
  incline = line(start = [r2, hLow], end = [r1, hHigh])
  highLanding = line(start = [r1, hHigh], end = [r0, hHigh])
  highEnd = line(start = [r0, hHigh], end = [r0, -epsilon])
}
rampRegion = region(segments = [rampSketch.root, rampSketch.lowEnd])
rampBody = extrude(
  rampRegion,
  length = rampWidth,
  tagStart = $rampSidePositive,
  tagEnd = $rampSideNegative,
)
withRamp = union([withStaircases, rampBody])
hide(rampRegion)
hide(rampPlane)

// Step 8: eight blind side cavities on q=-baseSide/2. Axes (eu,+Z) have normal +ev.
// The 60-degree rhombi have straight edges, with exact trigonometric widths.
tallWidth = lateralTallHeight * tan(lateralApexAngle / 2)
wideWidth = lateralWideHeight / tan(lateralApexAngle / 2)
lateralPlane = {
  origin = {
    x = (-halfSide - epsilon) * ev[0],
    y = (-halfSide - epsilon) * ev[1],
    z = 0mm
  },
  xAxis = { x = eu[0], y = eu[1], z = 0 },
  yAxis = { x = 0, y = 0, z = 1 }
}

lateralSmallRoundStation = lateralFirstStation - (0 * lateralPitch)
lateralSmallRoundSketch = sketch(on = lateralPlane) {
  bore = circle(
    center = [
      lateralSmallRoundStation,
      lateralCenterZ
    ],
    start = [
      lateralSmallRoundStation + lateralSmallDiameter / 2,
      lateralCenterZ
    ],
  )
}
lateralSmallRoundRegion = region(segments = [lateralSmallRoundSketch.bore])
lateralSmallRoundTool = extrude(lateralSmallRoundRegion, length = lateralSmallDepth + epsilon, tagEnd = $lateralSmallRoundBack)
withLateralSmallRound = subtract(withRamp, tools = [lateralSmallRoundTool])

lateralSmallSquareStation = lateralFirstStation - (1 * lateralPitch)
lateralSmallSquareSketch = sketch(on = lateralPlane) {
  wall1 = line(
    start = [
      lateralSmallSquareStation - (lateralSmallSquare / 2),
      lateralCenterZ - (lateralSmallSquare / 2)
    ],
    end = [
      lateralSmallSquareStation + lateralSmallSquare / 2,
      lateralCenterZ - (lateralSmallSquare / 2)
    ],
  )
  wall2 = line(
    start = [
      lateralSmallSquareStation + lateralSmallSquare / 2,
      lateralCenterZ - (lateralSmallSquare / 2)
    ],
    end = [
      lateralSmallSquareStation + lateralSmallSquare / 2,
      lateralCenterZ + lateralSmallSquare / 2
    ],
  )
  wall3 = line(
    start = [
      lateralSmallSquareStation + lateralSmallSquare / 2,
      lateralCenterZ + lateralSmallSquare / 2
    ],
    end = [
      lateralSmallSquareStation - (lateralSmallSquare / 2),
      lateralCenterZ + lateralSmallSquare / 2
    ],
  )
  wall4 = line(
    start = [
      lateralSmallSquareStation - (lateralSmallSquare / 2),
      lateralCenterZ + lateralSmallSquare / 2
    ],
    end = [
      lateralSmallSquareStation - (lateralSmallSquare / 2),
      lateralCenterZ - (lateralSmallSquare / 2)
    ],
  )
}
lateralSmallSquareRegion = region(segments = [
  lateralSmallSquareSketch.wall1,
  lateralSmallSquareSketch.wall2
])
lateralSmallSquareTool = extrude(lateralSmallSquareRegion, length = lateralSmallDepth + epsilon, tagEnd = $lateralSmallSquareBack)
withLateralSmallSquare = subtract(withLateralSmallRound, tools = [lateralSmallSquareTool])

lateralSmallDiamondStation = lateralFirstStation - (2 * lateralPitch)
lateralSmallDiamondSketch = sketch(on = lateralPlane) {
  wall1 = line(
    start = [
      lateralSmallDiamondStation,
      lateralCenterZ - (lateralSmallDiamond / 2)
    ],
    end = [
      lateralSmallDiamondStation + lateralSmallDiamond / 2,
      lateralCenterZ
    ],
  )
  wall2 = line(
    start = [
      lateralSmallDiamondStation + lateralSmallDiamond / 2,
      lateralCenterZ
    ],
    end = [
      lateralSmallDiamondStation,
      lateralCenterZ + lateralSmallDiamond / 2
    ],
  )
  wall3 = line(
    start = [
      lateralSmallDiamondStation,
      lateralCenterZ + lateralSmallDiamond / 2
    ],
    end = [
      lateralSmallDiamondStation - (lateralSmallDiamond / 2),
      lateralCenterZ
    ],
  )
  wall4 = line(
    start = [
      lateralSmallDiamondStation - (lateralSmallDiamond / 2),
      lateralCenterZ
    ],
    end = [
      lateralSmallDiamondStation,
      lateralCenterZ - (lateralSmallDiamond / 2)
    ],
  )
}
lateralSmallDiamondRegion = region(segments = [
  lateralSmallDiamondSketch.wall1,
  lateralSmallDiamondSketch.wall2
])
lateralSmallDiamondTool = extrude(lateralSmallDiamondRegion, length = lateralSmallDiamondDepth + epsilon, tagEnd = $lateralSmallDiamondBack)
withLateralSmallDiamond = subtract(withLateralSmallSquare, tools = [lateralSmallDiamondTool])

lateralLargeRoundStation = lateralFirstStation - (3 * lateralPitch)
lateralLargeRoundSketch = sketch(on = lateralPlane) {
  bore = circle(
    center = [
      lateralLargeRoundStation,
      lateralCenterZ
    ],
    start = [
      lateralLargeRoundStation + lateralLargeDiameter / 2,
      lateralCenterZ
    ],
  )
}
lateralLargeRoundRegion = region(segments = [lateralLargeRoundSketch.bore])
lateralLargeRoundTool = extrude(lateralLargeRoundRegion, length = lateralLargeDepth + epsilon, tagEnd = $lateralLargeRoundBack)
withLateralLargeRound = subtract(withLateralSmallDiamond, tools = [lateralLargeRoundTool])

lateralLargeSquareStation = lateralFirstStation - (4 * lateralPitch)
lateralLargeSquareSketch = sketch(on = lateralPlane) {
  wall1 = line(
    start = [
      lateralLargeSquareStation - (lateralLargeSquare / 2),
      lateralCenterZ - (lateralLargeSquare / 2)
    ],
    end = [
      lateralLargeSquareStation + lateralLargeSquare / 2,
      lateralCenterZ - (lateralLargeSquare / 2)
    ],
  )
  wall2 = line(
    start = [
      lateralLargeSquareStation + lateralLargeSquare / 2,
      lateralCenterZ - (lateralLargeSquare / 2)
    ],
    end = [
      lateralLargeSquareStation + lateralLargeSquare / 2,
      lateralCenterZ + lateralLargeSquare / 2
    ],
  )
  wall3 = line(
    start = [
      lateralLargeSquareStation + lateralLargeSquare / 2,
      lateralCenterZ + lateralLargeSquare / 2
    ],
    end = [
      lateralLargeSquareStation - (lateralLargeSquare / 2),
      lateralCenterZ + lateralLargeSquare / 2
    ],
  )
  wall4 = line(
    start = [
      lateralLargeSquareStation - (lateralLargeSquare / 2),
      lateralCenterZ + lateralLargeSquare / 2
    ],
    end = [
      lateralLargeSquareStation - (lateralLargeSquare / 2),
      lateralCenterZ - (lateralLargeSquare / 2)
    ],
  )
}
lateralLargeSquareRegion = region(segments = [
  lateralLargeSquareSketch.wall1,
  lateralLargeSquareSketch.wall2
])
lateralLargeSquareTool = extrude(lateralLargeSquareRegion, length = lateralLargeDepth + epsilon, tagEnd = $lateralLargeSquareBack)
withLateralLargeSquare = subtract(withLateralLargeRound, tools = [lateralLargeSquareTool])

lateralLargeDiamondStation = lateralFirstStation - (5 * lateralPitch)
lateralLargeDiamondSketch = sketch(on = lateralPlane) {
  wall1 = line(
    start = [
      lateralLargeDiamondStation,
      lateralCenterZ - (lateralLargeDiamond / 2)
    ],
    end = [
      lateralLargeDiamondStation + lateralLargeDiamond / 2,
      lateralCenterZ
    ],
  )
  wall2 = line(
    start = [
      lateralLargeDiamondStation + lateralLargeDiamond / 2,
      lateralCenterZ
    ],
    end = [
      lateralLargeDiamondStation,
      lateralCenterZ + lateralLargeDiamond / 2
    ],
  )
  wall3 = line(
    start = [
      lateralLargeDiamondStation,
      lateralCenterZ + lateralLargeDiamond / 2
    ],
    end = [
      lateralLargeDiamondStation - (lateralLargeDiamond / 2),
      lateralCenterZ
    ],
  )
  wall4 = line(
    start = [
      lateralLargeDiamondStation - (lateralLargeDiamond / 2),
      lateralCenterZ
    ],
    end = [
