      lateralCenterZ - (lateralLargeDiamond / 2)
    ],
  )
}
lateralLargeDiamondRegion = region(segments = [
  lateralLargeDiamondSketch.wall1,
  lateralLargeDiamondSketch.wall2
])
lateralLargeDiamondTool = extrude(lateralLargeDiamondRegion, length = lateralLargeDepth + epsilon, tagEnd = $lateralLargeDiamondBack)
withLateralLargeDiamond = subtract(withLateralLargeSquare, tools = [lateralLargeDiamondTool])

lateralTallRhombusStation = lateralFirstStation - (6 * lateralPitch)
lateralTallRhombusSketch = sketch(on = lateralPlane) {
  wall1 = line(
    start = [
      lateralTallRhombusStation,
      lateralCenterZ - (lateralTallHeight / 2)
    ],
    end = [
      lateralTallRhombusStation + tallWidth / 2,
      lateralCenterZ
    ],
  )
  wall2 = line(
    start = [
      lateralTallRhombusStation + tallWidth / 2,
      lateralCenterZ
    ],
    end = [
      lateralTallRhombusStation,
      lateralCenterZ + lateralTallHeight / 2
    ],
  )
  wall3 = line(
    start = [
      lateralTallRhombusStation,
      lateralCenterZ + lateralTallHeight / 2
    ],
    end = [
      lateralTallRhombusStation - (tallWidth / 2),
      lateralCenterZ
    ],
  )
  wall4 = line(
    start = [
      lateralTallRhombusStation - (tallWidth / 2),
      lateralCenterZ
    ],
    end = [
      lateralTallRhombusStation,
      lateralCenterZ - (lateralTallHeight / 2)
    ],
  )
}
lateralTallRhombusRegion = region(segments = [
  lateralTallRhombusSketch.wall1,
  lateralTallRhombusSketch.wall2
])
lateralTallRhombusTool = extrude(lateralTallRhombusRegion, length = lateralLargeDepth + epsilon, tagEnd = $lateralTallRhombusBack)
withLateralTallRhombus = subtract(withLateralLargeDiamond, tools = [lateralTallRhombusTool])

lateralWideRhombusStation = lateralFirstStation - (7 * lateralPitch)
lateralWideRhombusSketch = sketch(on = lateralPlane) {
  wall1 = line(
    start = [
      lateralWideRhombusStation,
      lateralCenterZ - (lateralWideHeight / 2)
    ],
    end = [
      lateralWideRhombusStation + wideWidth / 2,
      lateralCenterZ
    ],
  )
  wall2 = line(
    start = [
      lateralWideRhombusStation + wideWidth / 2,
      lateralCenterZ
    ],
    end = [
      lateralWideRhombusStation,
      lateralCenterZ + lateralWideHeight / 2
    ],
  )
  wall3 = line(
    start = [
      lateralWideRhombusStation,
      lateralCenterZ + lateralWideHeight / 2
    ],
    end = [
      lateralWideRhombusStation - (wideWidth / 2),
      lateralCenterZ
    ],
  )
  wall4 = line(
    start = [
      lateralWideRhombusStation - (wideWidth / 2),
      lateralCenterZ
    ],
    end = [
      lateralWideRhombusStation,
      lateralCenterZ - (lateralWideHeight / 2)
    ],
  )
}
lateralWideRhombusRegion = region(segments = [
  lateralWideRhombusSketch.wall1,
  lateralWideRhombusSketch.wall2
])
lateralWideRhombusTool = extrude(lateralWideRhombusRegion, length = lateralLargeDepth + epsilon, tagEnd = $lateralWideRhombusBack)
withLateralWideRhombus = subtract(withLateralTallRhombus, tools = [lateralWideRhombusTool])
hide([
  lateralSmallRoundRegion,
  lateralSmallSquareRegion,
  lateralSmallDiamondRegion,
  lateralLargeRoundRegion,
  lateralLargeSquareRegion,
  lateralLargeDiamondRegion,
  lateralTallRhombusRegion,
  lateralWideRhombusRegion
])
hide(lateralPlane)

// Step 9: five round bosses and five blind cylindrical pockets.
// Reflection across eu is v -> -v, which swaps x and y at 45 degrees.
fn reflectedXy(@point) {
  u = point[0] * eu[0] + point[1] * eu[1]
  v = point[0] * ev[0] + point[1] * ev[1]
  return xy(u, v = -v)
}
fineCenterA = [
  fineFirstX + 0 * finePitch * ev[0],
  fineFirstY + 0 * finePitch * ev[1]
]
fineReflectedCenterA = reflectedXy(fineCenterA)
finePinASketch = sketch(on = offsetPlane(XY, offset = -epsilon)) {
  boundary = circle(
    center = fineCenterA,
    start = [
      fineCenterA[0] + fineSizeA / 2,
      fineCenterA[1]
    ],
  )
}
finePinARegion = region(segments = [finePinASketch.boundary])
finePinATool = extrude(finePinARegion, length = fineHeightDepth + epsilon, tagEnd = $finePinACap)
withFinePinA = union([withLateralWideRhombus, finePinATool])
fineHoleASketch = sketch(on = offsetPlane(XY, offset = epsilon)) {
  boundary = circle(
    center = fineReflectedCenterA,
    start = [
      fineReflectedCenterA[0] + fineSizeA / 2,
      fineReflectedCenterA[1]
    ],
  )
}
fineHoleARegion = region(segments = [fineHoleASketch.boundary])
fineHoleATool = extrude(fineHoleARegion, length = -fineHeightDepth - epsilon, tagStart = $fineHoleACap)
withFineHoleA = subtract(withFinePinA, tools = [fineHoleATool])
fineCenterB = [
  fineFirstX + 1 * finePitch * ev[0],
  fineFirstY + 1 * finePitch * ev[1]
]
fineReflectedCenterB = reflectedXy(fineCenterB)
finePinBSketch = sketch(on = offsetPlane(XY, offset = -epsilon)) {
  boundary = circle(
    center = fineCenterB,
    start = [
      fineCenterB[0] + fineSizeB / 2,
      fineCenterB[1]
    ],
  )
}
finePinBRegion = region(segments = [finePinBSketch.boundary])
finePinBTool = extrude(finePinBRegion, length = fineHeightDepth + epsilon, tagEnd = $finePinBCap)
withFinePinB = union([withFineHoleA, finePinBTool])
fineHoleBSketch = sketch(on = offsetPlane(XY, offset = epsilon)) {
  boundary = circle(
    center = fineReflectedCenterB,
    start = [
      fineReflectedCenterB[0] + fineSizeB / 2,
      fineReflectedCenterB[1]
    ],
  )
}
fineHoleBRegion = region(segments = [fineHoleBSketch.boundary])
fineHoleBTool = extrude(fineHoleBRegion, length = -fineHeightDepth - epsilon, tagStart = $fineHoleBCap)
withFineHoleB = subtract(withFinePinB, tools = [fineHoleBTool])
fineCenterC = [
  fineFirstX + 2 * finePitch * ev[0],
  fineFirstY + 2 * finePitch * ev[1]
]
fineReflectedCenterC = reflectedXy(fineCenterC)
finePinCSketch = sketch(on = offsetPlane(XY, offset = -epsilon)) {
  boundary = circle(
    center = fineCenterC,
    start = [
      fineCenterC[0] + fineSizeC / 2,
      fineCenterC[1]
    ],
  )
}
finePinCRegion = region(segments = [finePinCSketch.boundary])
finePinCTool = extrude(finePinCRegion, length = fineHeightDepth + epsilon, tagEnd = $finePinCCap)
withFinePinC = union([withFineHoleB, finePinCTool])
fineHoleCSketch = sketch(on = offsetPlane(XY, offset = epsilon)) {
  boundary = circle(
    center = fineReflectedCenterC,
    start = [
      fineReflectedCenterC[0] + fineSizeC / 2,
      fineReflectedCenterC[1]
    ],
  )
}
fineHoleCRegion = region(segments = [fineHoleCSketch.boundary])
fineHoleCTool = extrude(fineHoleCRegion, length = -fineHeightDepth - epsilon, tagStart = $fineHoleCCap)
withFineHoleC = subtract(withFinePinC, tools = [fineHoleCTool])
fineCenterD = [
  fineFirstX + 3 * finePitch * ev[0],
  fineFirstY + 3 * finePitch * ev[1]
]
fineReflectedCenterD = reflectedXy(fineCenterD)
finePinDSketch = sketch(on = offsetPlane(XY, offset = -epsilon)) {
  boundary = circle(
    center = fineCenterD,
    start = [
      fineCenterD[0] + fineSizeD / 2,
      fineCenterD[1]
    ],
  )
}
finePinDRegion = region(segments = [finePinDSketch.boundary])
finePinDTool = extrude(finePinDRegion, length = fineHeightDepth + epsilon, tagEnd = $finePinDCap)
withFinePinD = union([withFineHoleC, finePinDTool])
fineHoleDSketch = sketch(on = offsetPlane(XY, offset = epsilon)) {
  boundary = circle(
    center = fineReflectedCenterD,
    start = [
      fineReflectedCenterD[0] + fineSizeD / 2,
      fineReflectedCenterD[1]
    ],
  )
}
fineHoleDRegion = region(segments = [fineHoleDSketch.boundary])
fineHoleDTool = extrude(fineHoleDRegion, length = -fineHeightDepth - epsilon, tagStart = $fineHoleDCap)
withFineHoleD = subtract(withFinePinD, tools = [fineHoleDTool])
fineCenterE = [
  fineFirstX + 4 * finePitch * ev[0],
  fineFirstY + 4 * finePitch * ev[1]
]
fineReflectedCenterE = reflectedXy(fineCenterE)
finePinESketch = sketch(on = offsetPlane(XY, offset = -epsilon)) {
  boundary = circle(
    center = fineCenterE,
    start = [
      fineCenterE[0] + fineSizeE / 2,
      fineCenterE[1]
    ],
  )
}
finePinERegion = region(segments = [finePinESketch.boundary])
finePinETool = extrude(finePinERegion, length = fineHeightDepth + epsilon, tagEnd = $finePinECap)
withFinePinE = union([withFineHoleD, finePinETool])
fineHoleESketch = sketch(on = offsetPlane(XY, offset = epsilon)) {
  boundary = circle(
    center = fineReflectedCenterE,
    start = [
      fineReflectedCenterE[0] + fineSizeE / 2,
      fineReflectedCenterE[1]
    ],
  )
}
fineHoleERegion = region(segments = [fineHoleESketch.boundary])
fineHoleETool = extrude(fineHoleERegion, length = -fineHeightDepth - epsilon, tagStart = $fineHoleECap)
withFineHoleE = subtract(withFinePinE, tools = [fineHoleETool])

// Step 10: ten exact rectangular bosses, with ten reflected blind slots.
rectOuter = halfSide - rectOuterInset
rectBoss1Sketch = sketch(on = offsetPlane(XY, offset = -epsilon)) {
  edge1 = line(start = xy(rectOuter - (rectLengthRatio * fineSizeA), v = rectStartV1 + fineSizeA), end = xy(rectOuter, v = rectStartV1 + fineSizeA))
  edge2 = line(start = xy(rectOuter, v = rectStartV1 + fineSizeA), end = xy(rectOuter, v = rectStartV1))
  edge3 = line(start = xy(rectOuter, v = rectStartV1), end = xy(rectOuter - (rectLengthRatio * fineSizeA), v = rectStartV1))
  edge4 = line(start = xy(rectOuter - (rectLengthRatio * fineSizeA), v = rectStartV1), end = xy(rectOuter - (rectLengthRatio * fineSizeA), v = rectStartV1 + fineSizeA))
}
rectBoss1Region = region(segments = [
  rectBoss1Sketch.edge1,
  rectBoss1Sketch.edge2
])
rectBoss1Tool = extrude(rectBoss1Region, length = fineHeightDepth + epsilon, tagEnd = $rectBoss1Cap)
withRectBoss1 = union([withFineHoleE, rectBoss1Tool])
rectSlot1Sketch = sketch(on = offsetPlane(XY, offset = epsilon)) {
  edge1 = line(start = xy(rectOuter - (rectLengthRatio * fineSizeA), v = -rectStartV1), end = xy(rectOuter, v = -rectStartV1))
  edge2 = line(start = xy(rectOuter, v = -rectStartV1), end = xy(rectOuter, v = -(rectStartV1 + fineSizeA)))
  edge3 = line(start = xy(rectOuter, v = -(rectStartV1 + fineSizeA)), end = xy(rectOuter - (rectLengthRatio * fineSizeA), v = -(rectStartV1 + fineSizeA)))
  edge4 = line(start = xy(rectOuter - (rectLengthRatio * fineSizeA), v = -(rectStartV1 + fineSizeA)), end = xy(rectOuter - (rectLengthRatio * fineSizeA), v = -rectStartV1))
}
rectSlot1Region = region(segments = [
  rectSlot1Sketch.edge1,
  rectSlot1Sketch.edge2
])
rectSlot1Tool = extrude(rectSlot1Region, length = -fineHeightDepth - epsilon, tagStart = $rectSlot1Cap)
withRectSlot1 = subtract(withRectBoss1, tools = [rectSlot1Tool])
rectBoss2Sketch = sketch(on = offsetPlane(XY, offset = -epsilon)) {
  edge1 = line(start = xy(rectOuter - (rectLengthRatio * fineSizeA), v = rectStartV2 + fineSizeA), end = xy(rectOuter, v = rectStartV2 + fineSizeA))
  edge2 = line(start = xy(rectOuter, v = rectStartV2 + fineSizeA), end = xy(rectOuter, v = rectStartV2))
  edge3 = line(start = xy(rectOuter, v = rectStartV2), end = xy(rectOuter - (rectLengthRatio * fineSizeA), v = rectStartV2))
  edge4 = line(start = xy(rectOuter - (rectLengthRatio * fineSizeA), v = rectStartV2), end = xy(rectOuter - (rectLengthRatio * fineSizeA), v = rectStartV2 + fineSizeA))
}
rectBoss2Region = region(segments = [
  rectBoss2Sketch.edge1,
  rectBoss2Sketch.edge2
])
rectBoss2Tool = extrude(rectBoss2Region, length = fineHeightDepth + epsilon, tagEnd = $rectBoss2Cap)
withRectBoss2 = union([withRectSlot1, rectBoss2Tool])
rectSlot2Sketch = sketch(on = offsetPlane(XY, offset = epsilon)) {
  edge1 = line(start = xy(rectOuter - (rectLengthRatio * fineSizeA), v = -rectStartV2), end = xy(rectOuter, v = -rectStartV2))
  edge2 = line(start = xy(rectOuter, v = -rectStartV2), end = xy(rectOuter, v = -(rectStartV2 + fineSizeA)))
  edge3 = line(start = xy(rectOuter, v = -(rectStartV2 + fineSizeA)), end = xy(rectOuter - (rectLengthRatio * fineSizeA), v = -(rectStartV2 + fineSizeA)))
  edge4 = line(start = xy(rectOuter - (rectLengthRatio * fineSizeA), v = -(rectStartV2 + fineSizeA)), end = xy(rectOuter - (rectLengthRatio * fineSizeA), v = -rectStartV2))
}
rectSlot2Region = region(segments = [
  rectSlot2Sketch.edge1,
  rectSlot2Sketch.edge2
])
rectSlot2Tool = extrude(rectSlot2Region, length = -fineHeightDepth - epsilon, tagStart = $rectSlot2Cap)
withRectSlot2 = subtract(withRectBoss2, tools = [rectSlot2Tool])
rectBoss3Sketch = sketch(on = offsetPlane(XY, offset = -epsilon)) {
  edge1 = line(start = xy(rectOuter - (rectLengthRatio * fineSizeB), v = rectStartV3 + fineSizeB), end = xy(rectOuter, v = rectStartV3 + fineSizeB))
  edge2 = line(start = xy(rectOuter, v = rectStartV3 + fineSizeB), end = xy(rectOuter, v = rectStartV3))
  edge3 = line(start = xy(rectOuter, v = rectStartV3), end = xy(rectOuter - (rectLengthRatio * fineSizeB), v = rectStartV3))
  edge4 = line(start = xy(rectOuter - (rectLengthRatio * fineSizeB), v = rectStartV3), end = xy(rectOuter - (rectLengthRatio * fineSizeB), v = rectStartV3 + fineSizeB))
}
rectBoss3Region = region(segments = [
  rectBoss3Sketch.edge1,
  rectBoss3Sketch.edge2
])
rectBoss3Tool = extrude(rectBoss3Region, length = fineHeightDepth + epsilon, tagEnd = $rectBoss3Cap)
withRectBoss3 = union([withRectSlot2, rectBoss3Tool])
rectSlot3Sketch = sketch(on = offsetPlane(XY, offset = epsilon)) {
  edge1 = line(start = xy(rectOuter - (rectLengthRatio * fineSizeB), v = -rectStartV3), end = xy(rectOuter, v = -rectStartV3))
  edge2 = line(start = xy(rectOuter, v = -rectStartV3), end = xy(rectOuter, v = -(rectStartV3 + fineSizeB)))
  edge3 = line(start = xy(rectOuter, v = -(rectStartV3 + fineSizeB)), end = xy(rectOuter - (rectLengthRatio * fineSizeB), v = -(rectStartV3 + fineSizeB)))
  edge4 = line(start = xy(rectOuter - (rectLengthRatio * fineSizeB), v = -(rectStartV3 + fineSizeB)), end = xy(rectOuter - (rectLengthRatio * fineSizeB), v = -rectStartV3))
}
rectSlot3Region = region(segments = [
  rectSlot3Sketch.edge1,
  rectSlot3Sketch.edge2
])
rectSlot3Tool = extrude(rectSlot3Region, length = -fineHeightDepth - epsilon, tagStart = $rectSlot3Cap)
withRectSlot3 = subtract(withRectBoss3, tools = [rectSlot3Tool])
rectBoss4Sketch = sketch(on = offsetPlane(XY, offset = -epsilon)) {
